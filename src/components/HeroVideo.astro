---
// Browser-compatible H.264 background with AAC audio derived from the approved stadium-rock video:
// https://assets.cdn.filesafe.space/752TznWg3s9PT7P486mf/media/6ac52fd9bbad531ac8f22cf0.mov
---
<div class="hero-video" data-hero-video>
  <video muted loop playsinline preload="none" poster="/media/renegade-stadium-hero.jpg" aria-hidden="true" tabindex="-1" disablepictureinpicture>
    <source data-src="/media/renegade-stadium-hero.mp4" type="video/mp4" />
  </video>
  <div class="hero-video-shade"></div>
  <div class="hero-video-controls" hidden>
    <button type="button" data-play>Pause background video</button>
    <button type="button" data-sound aria-pressed="false">Turn sound on</button>
  </div>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-hero-video]').forEach(root => {
    const video = root.querySelector('video')!;
    const source = video.querySelector('source')!;
    const controls = root.querySelector<HTMLElement>('.hero-video-controls')!;
    const button = root.querySelector<HTMLButtonElement>('[data-play]')!;
    const sound = root.querySelector<HTMLButtonElement>('[data-sound]')!;
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let userPaused = false;
    const sync = () => {
      button.textContent = video.paused ? 'Play background video' : 'Pause background video';
      sound.textContent = video.muted ? 'Turn sound on' : 'Turn sound off';
      sound.setAttribute('aria-pressed', String(!video.muted));
    };
    const play = async () => {
      if (!source.src) { source.src = source.dataset.src!; video.load(); }
      try { await video.play(); controls.hidden = false; sync(); }
      catch { controls.hidden = false; sync(); }
    };
    button.addEventListener('click', () => {
      if (video.paused) { userPaused = false; void play(); }
      else { userPaused = true; video.pause(); sync(); }
    });
    sound.addEventListener('click', () => {
      video.muted = !video.muted;
      if (!video.muted && video.paused) { userPaused = false; void play(); }
      sync();
    });
    video.addEventListener('volumechange', sync);
    motion.addEventListener('change', () => {
      if (motion.matches) { video.pause(); sync(); }
      else if (!userPaused) { void play(); }
    });
    video.addEventListener('error', () => { video.hidden = true; controls.hidden = true; });
    video.addEventListener('playing', sync);
    video.addEventListener('pause', sync);
    controls.hidden = false;
    sync();
    if (!motion.matches) void play();
  });
</script>
<style>
  .hero-video{position:absolute;inset:0;z-index:0;background:#080808 url('/media/renegade-stadium-hero.jpg') center/cover no-repeat;pointer-events:none}
  video{width:100%;height:100%;object-fit:cover;display:block}
  .hero-video-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(0,0,0,.42),rgba(0,0,0,.18)),linear-gradient(0deg,rgba(0,0,0,.3),transparent 45%)}
  .hero-video-controls{position:absolute;right:24px;bottom:14px;display:flex;gap:8px;flex-wrap:wrap;pointer-events:auto;z-index:3}
  button{border:1px solid #aaa;border-radius:3px;background:rgba(0,0,0,.8);color:#fff;padding:8px 12px;font:500 12px/1.4 'Inter',sans-serif;cursor:pointer}
  button:focus-visible{outline:3px solid #f4c20d;outline-offset:3px}
  .hero-video-controls[hidden]{display:none}
  @media(max-width:640px){.hero-video-controls{right:16px;bottom:12px}button{font-size:11px;padding:7px 9px}}
</style>
