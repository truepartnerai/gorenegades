---
import { links } from '../lib/links.js';
import { brand } from '../lib/site.js';

// Props kept for compatibility with pages that pass them.
const { ctaLabel = 'Start for $99/mo', ctaHref = links.crmMonthly } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/crm', label: 'Renegade CRM' },
  { href: '/academy', label: 'Academy' },
  { href: '/community', label: 'Community' },
  { href: '/blog', label: 'Blog' },
  { href: '/podcast', label: 'Podcast' },
  { href: '/about', label: 'About' }
];
const current = (href) => (path === href || path.startsWith(href + '/') ? 'page' : undefined);
---

<nav class="pn" aria-label="Primary navigation">
  <div class="p-wrap pn-in">
    <a class="pn-brand" href="/" aria-label="Marketing Renegades home">
      {brand.logo
        ? <img class="pn-logo" src={brand.logo} alt={brand.logoAlt} />
        : <>{brand.insignia && <img class="pn-insignia" src={brand.insignia} alt="" width="40" height="40" />}<span>Marketing <b>Renegades</b></span></>}
    </a>

    <div class="pn-links">
      {nav.map((item) => <a href={item.href} aria-current={current(item.href)}>{item.label}</a>)}
    </div>

    <a class="pn-cta" href={ctaHref}>{ctaLabel}</a>

    <details class="pn-menu">
      <summary aria-label="Open navigation menu">Menu</summary>
      <div class="pn-panel">
        <a href="/crm">Renegade CRM <small>The system · $99/mo</small></a>
        <a href="/academy">Renegade Academy <small>8-week semester · $199/mo</small></a>
        <a href="/community">Renegade Community <small>Ideas and Power Hours · Free</small></a>
        <a href="/blog">Blog <small>Articles, playbooks and field notes</small></a>
        <a href="/podcast">Podcast <small>The No Fear Marketing Show</small></a>
        <a href="/about">About</a>
        <a class="p-btn p-btn-primary" href={links.crmMonthly} rel="noopener">Start for $99/mo</a>
      </div>
    </details>
  </div>
</nav>
