---
interface Props {
  title: string;
  series?: string;
  category?: string;
  image?: string;
  imageAlt?: string;
  visualKicker?: string;
  tone?: 'gold' | 'blue' | 'cream' | 'mono';
  compact?: boolean;
}

const {
  title,
  series,
  category,
  image,
  imageAlt = '',
  visualKicker,
  tone = 'gold',
  compact = false
} = Astro.props;

const kicker = visualKicker || series || category || 'Renegade Ideas';
---

<div class:list={['editorial-cover', `editorial-cover--${tone}`, compact && 'editorial-cover--compact']}>
  {image ? (
    <>
      <img src={image} alt={imageAlt} loading={compact ? 'lazy' : 'eager'} />
      <div class="editorial-cover-shade"></div>
      <div class="editorial-cover-overlay">
        <span class="editorial-cover-brand">Marketing Renegades</span>
        <strong>{kicker}</strong>
      </div>
    </>
  ) : (
    <div class="editorial-cover-generated" aria-hidden="true">
      <span class="editorial-cover-brand">Marketing Renegades</span>
      <div class="editorial-cover-lines"></div>
      <strong>{kicker}</strong>
      <span class="editorial-cover-title">{title}</span>
      <span class="editorial-cover-stamp">MR / IDEAS</span>
    </div>
  )}
</div>
