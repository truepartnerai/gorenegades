---
import { tone as toTone } from '../lib/media.js';
interface Props { title: string; kicker?: string; series?: string; image?: string; imageAlt?: string; tone?: string; large?: boolean }
const { title, kicker, series, image, imageAlt = '', tone = 'gold', large = false } = Astro.props;
---
<div class:list={['pc', `pc--${toTone(tone)}`, large && 'pc-lg']}>
  {image && <img src={image} alt={imageAlt} loading={large ? 'eager' : 'lazy'} />}
  <div class="pc-brand">Marketing Renegades</div>
  {!image && <div>
    {series && <span class="pc-series">{series}</span>}
    <div class="pc-title" style="margin-top:12px">{kicker || title}</div>
  </div>}
</div>
