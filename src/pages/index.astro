---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const capabilities = [
  ['Capture leads','Forms, landing pages, calendars and funnels bring new opportunities into one place.'],
  ['Follow up automatically','Use email, text, tasks and workflows so good leads do not quietly disappear.'],
  ['Work your database','Stay in touch with past clients, prospects and referral partners without relying on memory.'],
  ['Stay visible','Plan email, content and social communication so marketing keeps moving when business gets busy.'],
  ['Build reputation','Make reviews and referrals part of the customer journey instead of an occasional ask.'],
  ['See what is happening','Use pipelines and contact history to know who needs attention and what happens next.']
];

const faqs = [
  ['Is Marketing Renegades a CRM company?','Partly. Renegade CRM is the software layer, but the bigger idea is helping entrepreneurs build marketing systems that actually run. The software, playbooks, implementation help and community are designed to work together.'],
  ['Who is this for?','Entrepreneurs and independent business owners who want better lead follow-up, database marketing, automation, visibility and organization without assembling a giant stack of disconnected tools.'],
  ['Where should I start?','If you want the system and software, start with Renegade CRM. If you want hands-on implementation, look at Renegade Academy. If you want to learn first, join the free Renegade Community.'],
  ['Do I have to use everything at once?','No. Start with the marketing problem that matters most, get that piece working, then add the next one.']
];
---

<BaseLayout
  title="Marketing Renegades | Smarter Marketing Systems for Entrepreneurs"
  description="Marketing Renegades helps entrepreneurs solve marketing and growth problems using smarter systems, tools and automation."
>
  <div class="page home-v4">
    <Header ctaLabel="See Renegade CRM" ctaHref="/crm" />

    <main>
      <section class="hero-v4">
        <div class="wrap hero-grid-v4">
          <div class="hero-copy">
            <span class="kicker">Marketing systems for entrepreneurs</span>
            <h1>Get your marketing <span>out of your head.</span> Into a system.</h1>
            <p class="hero-core">We help entrepreneurs solve marketing and growth problems using smarter systems, tools and automation.</p>
            <p class="hero-explain">Capture leads. Follow up faster. Work your database. Stay visible. Ask for reviews and referrals. Keep opportunities moving — without trying to remember everything yourself.</p>

            <div class="cta-row">
              <a class="primary-cta" href="/crm">See Renegade CRM <span>→</span></a>
              <a class="secondary-cta" href="https://community.gorenegades.com">Join the free community</a>
            </div>

            <div class="hero-meta">
              <span>$99/mo CRM</span>
              <span>Practical playbooks</span>
              <span>Live implementation available</span>
            </div>
          </div>

          <div class="system-demo" aria-label="Example Renegade marketing system">
            <div class="demo-top">
              <div>
                <span class="demo-label">Renegade marketing system</span>
                <strong>Opportunity flow</strong>
              </div>
              <span class="live-pill">RUNNING</span>
            </div>

            <div class="demo-flow">
              <div class="flow-card">
                <span class="flow-num">01</span>
                <div><b>Capture</b><small>Lead form · Call · Event</small></div>
                <span class="flow-check">✓</span>
              </div>
              <div class="flow-line"></div>
              <div class="flow-card">
                <span class="flow-num">02</span>
                <div><b>Follow up</b><small>Email · SMS · Tasks</small></div>
                <span class="flow-check">✓</span>
              </div>
              <div class="flow-line"></div>
              <div class="flow-card">
                <span class="flow-num">03</span>
                <div><b>Stay visible</b><small>Database · Content · Nurture</small></div>
                <span class="flow-check">✓</span>
              </div>
              <div class="flow-line"></div>
              <div class="flow-card active">
                <span class="flow-num">04</span>
                <div><b>Create opportunity</b><small>Appointment · Referral · Sale</small></div>
                <span class="flow-arrow">→</span>
              </div>
            </div>

            <div class="demo-bottom">
              <span>CRM</span><span>Automation</span><span>Email + SMS</span><span>AI</span>
            </div>
          </div>
        </div>
      </section>

      <section class="problem-strip">
        <div class="wrap problem-grid">
          <div><strong>Leads come in.</strong><span>Follow-up gets inconsistent.</span></div>
          <div><strong>You have a database.</strong><span>Most of it sits untouched.</span></div>
          <div><strong>You know what to do.</strong><span>Running the business gets in the way.</span></div>
        </div>
      </section>

      <section class="section-v4">
        <div class="wrap">
          <div class="section-head">
            <span class="kicker">What Marketing Renegades does</span>
            <h2>Turn scattered marketing into a system that keeps moving.</h2>
            <p>We combine the software, the marketing playbooks and the implementation support so you can solve one growth problem at a time without rebuilding your marketing every week.</p>
          </div>

          <div class="cap-grid">
            {capabilities.map(([title,text],i) => (
              <article class="cap-card">
                <span class="cap-num">{String(i+1).padStart(2,'0')}</span>
                <h3>{title}</h3>
                <p>{text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="product-section">
        <div class="wrap product-grid">
          <div class="product-copy">
            <span class="kicker dark-kicker">Start here</span>
            <h2>Your marketing system. <span>$99/month.</span></h2>
            <p>Renegade CRM puts the core pieces of your marketing in one place: contacts, pipelines, email, text, automation, calendars, landing pages, reviews, social tools and AI-assisted features.</p>
            <ul>
              <li><span>✓</span> Organize leads and customer relationships</li>
              <li><span>✓</span> Automate repetitive follow-up</li>
              <li><span>✓</span> Work your database consistently</li>
              <li><span>✓</span> Build campaigns without another disconnected app</li>
              <li><span>✓</span> Use Renegade playbooks to decide what to build first</li>
            </ul>
            <div class="cta-row">
              <a class="primary-cta dark" href="/crm">Explore Renegade CRM <span>→</span></a>
            </div>
          </div>

          <aside class="price-card">
            <span class="price-kicker">Renegade CRM</span>
            <div class="price"><sup>$</sup>99<span>/mo</span></div>
            <p>One place for the marketing work that keeps getting scattered across your business.</p>
            <div class="stack-list">
              <span>CRM + Pipelines</span>
              <span>Email + SMS</span>
              <span>Automation</span>
              <span>Forms + Funnels</span>
              <span>Reviews</span>
              <span>Calendars</span>
              <span>Social Planner</span>
              <span>AI Tools</span>
            </div>
            <a href="/crm">See everything included →</a>
          </aside>
        </div>
      </section>

      <section class="paths-section">
        <div class="wrap">
          <div class="section-head compact">
            <span class="kicker">Choose your level of help</span>
            <h2>Software when you want the tools. People when you want help building.</h2>
          </div>

          <div class="path-grid">
            <article class="path-card featured">
              <span class="path-label">Renegade CRM</span>
              <h3>Run the system.</h3>
              <p>The software and playbooks for entrepreneurs ready to organize and automate their marketing.</p>
              <strong>$99/month</strong>
              <a href="/crm">See Renegade CRM →</a>
            </article>

            <article class="path-card">
              <span class="path-label">Renegade Academy</span>
              <h3>Build it with us.</h3>
              <p>Live implementation for owners who want help turning the strategy into campaigns, workflows and a repeatable marketing rhythm.</p>
              <strong>8-week live program</strong>
              <a href="/academy">Explore Academy →</a>
            </article>

            <article class="path-card">
              <span class="path-label">Renegade Community</span>
              <h3>Learn with us.</h3>
              <p>Playbooks, Power Hours, experiments, new tech and practical ideas you can use before you buy anything.</p>
              <strong>Free to join</strong>
              <a href="https://community.gorenegades.com">Join the community →</a>
            </article>
          </div>
        </div>
      </section>

      <section class="how-section">
        <div class="wrap how-grid">
          <div class="how-copy">
            <span class="kicker">The Renegade approach</span>
            <h2>Do not automate everything. Automate the right things.</h2>
            <p>The goal is not more software. It is a business where important marketing happens consistently and the owner does not have to carry every reminder, follow-up and campaign in their head.</p>
          </div>

          <div class="steps">
            <div><span>01</span><section><strong>Pick the problem</strong><p>Follow-up, database, leads, reviews, visibility or another bottleneck.</p></section></div>
            <div><span>02</span><section><strong>Build the system</strong><p>Use the right tool, workflow and message for that job.</p></section></div>
            <div><span>03</span><section><strong>Get it running</strong><p>Measure what happens, improve it, then add the next piece.</p></section></div>
          </div>
        </div>
      </section>

      <section class="faq-section">
        <div class="wrap faq-grid">
          <div class="faq-head">
            <span class="kicker">Straight answers</span>
            <h2>What exactly is Marketing Renegades?</h2>
          </div>
          <div class="faq-list">
            {faqs.map(([q,a]) => (
              <details>
                <summary>{q}</summary>
                <p>{a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section class="final-v4">
        <div class="wrap final-grid">
          <div>
            <span class="kicker">Make the next marketing problem easier</span>
            <h2>Put a system behind your growth.</h2>
          </div>
          <div>
            <p>Start with Renegade CRM for $99/month, or join the community and see how we think before you spend a dollar.</p>
            <div class="cta-row">
              <a class="primary-cta" href="/crm">See Renegade CRM <span>→</span></a>
              <a class="secondary-cta" href="https://community.gorenegades.com">Join free</a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </div>
</BaseLayout>

<style>
  .home-v4{background:#090909;color:#f7f7f5}
  .home-v4 *{box-sizing:border-box}
  .kicker{display:inline-flex;align-items:center;gap:9px;font:700 11px/1 var(--mono);letter-spacing:.14em;text-transform:uppercase;color:var(--gold)}
  .kicker:before{content:'';width:24px;height:2px;background:var(--gold)}

  .hero-v4{padding:88px 0 84px;position:relative;overflow:hidden;background:radial-gradient(circle at 76% 30%,rgba(244,194,13,.13),transparent 30%),linear-gradient(180deg,#0a0a0a 0%,#0c0c0c 100%)}
  .hero-grid-v4{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(420px,.95fr);gap:74px;align-items:center}
  .hero-copy h1{font-family:var(--body);font-size:clamp(54px,6.8vw,92px);line-height:.96;letter-spacing:-.055em;font-weight:700;max-width:930px;margin-top:22px}
  .hero-copy h1 span{color:var(--gold)}
  .hero-core{font-size:clamp(21px,2vw,28px);line-height:1.35;letter-spacing:-.02em;max-width:780px;margin-top:32px;color:#fff;font-weight:600}
  .hero-explain{font-size:17px;line-height:1.7;max-width:720px;margin-top:18px;color:#aaa}
  .cta-row{display:flex;flex-wrap:wrap;gap:12px;margin-top:32px}
  .primary-cta,.secondary-cta{display:inline-flex;align-items:center;justify-content:center;min-height:52px;padding:0 22px;border-radius:8px;font-size:15px;font-weight:700;transition:.18s ease}
  .primary-cta{background:var(--gold);color:#0a0a0a;border:1px solid var(--gold)}
  .primary-cta:hover{background:var(--gold-soft);transform:translateY(-1px)}
  .primary-cta span{margin-left:12px}
  .secondary-cta{border:1px solid #333;color:#fff;background:#111}
  .secondary-cta:hover{border-color:var(--gold);color:var(--gold)}
  .hero-meta{display:flex;flex-wrap:wrap;gap:10px 22px;margin-top:26px;color:#777;font-size:12px}
  .hero-meta span:before{content:'•';color:var(--gold);margin-right:8px}

  .system-demo{background:#101010;border:1px solid #2b2b2b;border-radius:16px;padding:24px;box-shadow:0 30px 80px rgba(0,0,0,.45),0 0 0 1px rgba(244,194,13,.04);position:relative}
  .system-demo:before{content:'';position:absolute;inset:-1px;border-radius:16px;padding:1px;background:linear-gradient(135deg,rgba(244,194,13,.55),transparent 35%,transparent 70%,rgba(244,194,13,.12));-webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask-composite:exclude;pointer-events:none}
  .demo-top{display:flex;justify-content:space-between;gap:20px;align-items:center;padding-bottom:20px;border-bottom:1px solid #242424}
  .demo-top strong{display:block;font-size:20px;margin-top:5px}
  .demo-label{font:700 9px/1 var(--mono);letter-spacing:.14em;text-transform:uppercase;color:#777}
  .live-pill{font:700 9px/1 var(--mono);letter-spacing:.12em;background:rgba(244,194,13,.12);color:var(--gold);border:1px solid rgba(244,194,13,.35);padding:7px 9px;border-radius:999px}
  .demo-flow{padding:24px 0}
  .flow-card{display:grid;grid-template-columns:36px 1fr 26px;gap:12px;align-items:center;background:#151515;border:1px solid #252525;border-radius:10px;padding:14px}
  .flow-card.active{border-color:rgba(244,194,13,.6);background:rgba(244,194,13,.06)}
  .flow-num{font:700 10px/1 var(--mono);color:#666}
  .flow-card b{display:block;font-size:14px}
  .flow-card small{display:block;color:#777;font-size:11px;margin-top:2px}
  .flow-check{width:23px;height:23px;border-radius:50%;display:grid;place-items:center;background:rgba(244,194,13,.10);color:var(--gold);font-size:12px}
  .flow-arrow{color:var(--gold);font-size:19px}
  .flow-line{width:1px;height:12px;background:#333;margin:0 0 0 31px}
  .demo-bottom{display:flex;flex-wrap:wrap;gap:8px;border-top:1px solid #242424;padding-top:18px}
  .demo-bottom span{font:700 9px/1 var(--mono);letter-spacing:.08em;text-transform:uppercase;color:#888;border:1px solid #292929;border-radius:6px;padding:7px 9px}

  .problem-strip{border-top:1px solid #1f1f1f;border-bottom:1px solid #1f1f1f;background:#0d0d0d}
  .problem-grid{display:grid;grid-template-columns:repeat(3,1fr)}
  .problem-grid>div{padding:24px 28px;border-right:1px solid #232323}
  .problem-grid>div:last-child{border-right:0}
  .problem-grid strong{display:block;font-size:15px;color:#fff}
  .problem-grid span{display:block;font-size:13px;color:#777;margin-top:3px}

  .section-v4,.paths-section,.how-section,.faq-section{padding:104px 0}
  .section-head{max-width:820px}
  .section-head h2,.how-copy h2,.faq-head h2{font-family:var(--body);font-size:clamp(40px,5vw,66px);line-height:1.03;letter-spacing:-.045em;margin-top:18px}
  .section-head>p,.how-copy>p{font-size:18px;line-height:1.7;color:#999;max-width:720px;margin-top:22px}
  .section-head.compact{max-width:930px}

  .cap-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:48px}
  .cap-card{background:#101010;border:1px solid #222;border-radius:12px;padding:26px;min-height:220px;transition:.18s ease}
  .cap-card:hover{border-color:rgba(244,194,13,.5);transform:translateY(-2px)}
  .cap-num{font:700 10px/1 var(--mono);color:var(--gold)}
  .cap-card h3{font-size:22px;letter-spacing:-.02em;margin-top:28px}
  .cap-card p{font-size:14px;line-height:1.65;color:#888;margin-top:10px}

  .product-section{padding:104px 0;background:var(--gold);color:#0a0a0a}
  .product-grid{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(360px,.65fr);gap:76px;align-items:center}
  .dark-kicker{color:#0a0a0a}
  .dark-kicker:before{background:#0a0a0a}
  .product-copy h2{font-family:var(--body);font-size:clamp(44px,5vw,70px);line-height:1;letter-spacing:-.05em;margin-top:18px;max-width:760px}
  .product-copy h2 span{display:block}
  .product-copy>p{font-size:18px;line-height:1.65;max-width:720px;margin-top:24px;color:#302806}
  .product-copy ul{list-style:none;margin-top:28px;display:grid;gap:10px}
  .product-copy li{font-size:15px;font-weight:600}
  .product-copy li span{margin-right:10px}
  .primary-cta.dark{background:#0a0a0a;color:var(--gold);border-color:#0a0a0a}
  .primary-cta.dark:hover{background:#1b1b1b}
  .price-card{background:#0b0b0b;color:#fff;border:1px solid rgba(0,0,0,.3);border-radius:16px;padding:32px;box-shadow:0 24px 60px rgba(0,0,0,.22)}
  .price-kicker{font:700 10px/1 var(--mono);letter-spacing:.14em;text-transform:uppercase;color:var(--gold)}
  .price{font-size:86px;font-weight:700;letter-spacing:-.07em;line-height:.9;margin-top:22px}
  .price sup{font-size:30px;vertical-align:top;position:relative;top:8px}
  .price>span{font-size:18px;letter-spacing:-.02em;color:#777;margin-left:8px}
  .price-card>p{color:#aaa;font-size:14px;line-height:1.6;margin-top:18px}
  .stack-list{display:flex;flex-wrap:wrap;gap:8px;margin:24px 0}
  .stack-list span{font:700 9px/1 var(--mono);letter-spacing:.06em;text-transform:uppercase;color:#bbb;border:1px solid #2a2a2a;border-radius:6px;padding:8px}
  .price-card>a{color:var(--gold);font-size:14px;font-weight:700}

  .paths-section{background:#0c0c0c}
  .path-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:46px}
  .path-card{background:#111;border:1px solid #242424;border-radius:12px;padding:28px;min-height:320px;display:flex;flex-direction:column}
  .path-card.featured{border-color:rgba(244,194,13,.6);box-shadow:inset 0 3px 0 var(--gold)}
  .path-label{font:700 10px/1 var(--mono);letter-spacing:.12em;text-transform:uppercase;color:var(--gold)}
  .path-card h3{font-size:28px;letter-spacing:-.03em;margin-top:30px}
  .path-card p{font-size:14px;line-height:1.65;color:#888;margin-top:12px}
  .path-card strong{font-size:13px;margin-top:auto;padding-top:28px;color:#ddd}
  .path-card a{font-size:14px;font-weight:700;color:var(--gold);margin-top:12px}

  .how-section{background:#090909}
  .how-grid{display:grid;grid-template-columns:1fr 1fr;gap:82px;align-items:start}
  .steps{border-top:1px solid #252525}
  .steps>div{display:grid;grid-template-columns:56px 1fr;gap:20px;padding:24px 0;border-bottom:1px solid #252525}
  .steps>div>span{font:700 11px/1 var(--mono);color:var(--gold);padding-top:5px}
  .steps strong{font-size:18px}
  .steps p{font-size:14px;line-height:1.6;color:#888;margin-top:6px}

  .faq-section{background:#0d0d0d}
  .faq-grid{display:grid;grid-template-columns:.7fr 1.3fr;gap:80px;align-items:start}
  .faq-list{border-top:1px solid #292929}
  .faq-list details{border-bottom:1px solid #292929}
  .faq-list summary{cursor:pointer;list-style:none;padding:22px 0;font-size:17px;font-weight:700}
  .faq-list summary::-webkit-details-marker{display:none}
  .faq-list summary:after{content:'+';float:right;color:var(--gold)}
  .faq-list details[open] summary:after{content:'−'}
  .faq-list p{color:#888;font-size:14px;line-height:1.7;padding:0 0 22px;max-width:740px}

  .final-v4{padding:86px 0;background:linear-gradient(135deg,#101010,#090909);border-top:1px solid #222}
  .final-grid{display:grid;grid-template-columns:1fr .8fr;gap:70px;align-items:center}
  .final-v4 h2{font-family:var(--body);font-size:clamp(42px,5vw,68px);line-height:1;letter-spacing:-.045em;margin-top:16px}
  .final-v4 p{font-size:17px;line-height:1.65;color:#999;max-width:560px}

  @media(max-width:980px){
    .hero-grid-v4,.product-grid,.how-grid,.faq-grid,.final-grid{grid-template-columns:1fr}
    .hero-grid-v4{gap:46px}
    .system-demo{max-width:700px}
    .cap-grid,.path-grid{grid-template-columns:1fr 1fr}
    .problem-grid{grid-template-columns:1fr}
    .problem-grid>div{border-right:0;border-bottom:1px solid #232323}
    .problem-grid>div:last-child{border-bottom:0}
  }
  @media(max-width:640px){
    .hero-v4{padding:64px 0 58px}
    .hero-copy h1{font-size:clamp(44px,13vw,62px)}
    .hero-core{font-size:20px}
    .hero-explain{font-size:16px}
    .system-demo{padding:18px}
    .section-v4,.paths-section,.how-section,.faq-section,.product-section{padding:78px 0}
    .cap-grid,.path-grid{grid-template-columns:1fr}
    .cap-card{min-height:0}
    .product-grid{gap:42px}
    .price{font-size:72px}
    .final-v4{padding:72px 0}
    .primary-cta,.secondary-cta{width:100%}
  }
</style>
