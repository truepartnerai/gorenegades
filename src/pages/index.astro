---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const outcomes = [
  ['Follow up consistently','Keep leads and opportunities moving with email, text, tasks and automation.'],
  ['Work your database','Stay in touch with past clients, prospects and referral partners without relying on memory.'],
  ['Create new opportunities','Use landing pages, forms, events and campaigns to bring more people into your world.'],
  ['Stay visible','Keep useful email, content and social communication moving without starting over every week.'],
  ['Build reviews and referrals','Make the ask part of the customer journey instead of something that happens occasionally.'],
  ['Organize the marketing','See contacts, conversations, pipelines and next steps in one place.']
];
---

<BaseLayout
  title="Marketing Renegades | Smarter Marketing Systems for Entrepreneurs"
  description="Marketing Renegades helps entrepreneurs solve marketing and growth problems using smarter systems, tools and automation."
>
<div class="page light-home">
  <Header ctaLabel="Explore Renegade CRM" ctaHref="/crm" />
  <main>
    <section class="hero">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <span class="eyebrow">Marketing Renegades</span>
          <h1>Smarter marketing systems for entrepreneurs.</h1>
          <p class="lead">We help entrepreneurs solve marketing and growth problems using smarter systems, tools and automation.</p>
          <p class="support">Bring your leads, follow-up, database, reviews, referrals, content and customer communication into a system that is easier to run and easier to improve.</p>
          <div class="actions">
            <a class="btn-primary" href="/crm">Explore Renegade CRM</a>
            <a class="btn-secondary" href="https://community.gorenegades.com">Join the free community</a>
          </div>
          <div class="meta">
            <span>Renegade CRM · $99/mo</span>
            <span>Renegade Academy · Live implementation</span>
            <span>Community · Free</span>
          </div>
        </div>

        <aside class="overview-card">
          <div class="overview-head">
            <span>What we help you run</span>
            <strong>Your marketing system</strong>
          </div>
          <div class="overview-list">
            <div><span>01</span><p><b>Capture</b><small>Leads, forms, calls, appointments</small></p></div>
            <div><span>02</span><p><b>Follow up</b><small>Email, text, tasks, workflows</small></p></div>
            <div><span>03</span><p><b>Stay visible</b><small>Database, content, social, nurture</small></p></div>
            <div><span>04</span><p><b>Create opportunity</b><small>Appointments, referrals, sales</small></p></div>
          </div>
        </aside>
      </div>
    </section>

    <section class="clarity">
      <div class="wrap clarity-grid">
        <div>
          <span class="mini">WHO IT'S FOR</span>
          <strong>Entrepreneurs and independent business owners</strong>
        </div>
        <div>
          <span class="mini">WHAT WE SOLVE</span>
          <strong>Marketing that feels scattered, inconsistent or hard to manage</strong>
        </div>
        <div>
          <span class="mini">HOW WE HELP</span>
          <strong>Systems, software, automation and practical implementation</strong>
        </div>
      </div>
    </section>

    <section class="section white">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow">The work</span>
          <h2>Make the important marketing easier to keep doing.</h2>
          <p>You do not need every tactic. You need the right few activities organized well enough to happen consistently.</p>
        </div>
        <div class="outcome-grid">
          {outcomes.map(([title,text],i) => (
            <article>
              <span class="num">{String(i+1).padStart(2,'0')}</span>
              <h3>{title}</h3>
              <p>{text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section gray">
      <div class="wrap product-grid">
        <div>
          <span class="eyebrow">Renegade CRM</span>
          <h2>One place to run the marketing that matters.</h2>
          <p class="section-copy">Renegade CRM brings your contacts, pipelines, email, text, automation, calendars, forms, landing pages, reviews, social tools and more into one system.</p>
          <p class="section-copy">The playbooks help you decide what to build first, so the software has a job to do from day one.</p>
          <a class="text-link" href="/crm">See Renegade CRM →</a>
        </div>
        <aside class="price-card">
          <span>Renegade CRM</span>
          <div class="price"><sup>$</sup>99<small>/month</small></div>
          <ul>
            <li>CRM + pipelines</li>
            <li>Email + SMS</li>
            <li>Automation</li>
            <li>Calendars + forms</li>
            <li>Reviews + social tools</li>
            <li>Renegade playbooks</li>
          </ul>
          <a class="btn-dark" href="/crm">Explore the system</a>
        </aside>
      </div>
    </section>

    <section class="section white">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow">Three ways to use Marketing Renegades</span>
          <h2>Start where you need the most help.</h2>
        </div>
        <div class="paths">
          <article>
            <span class="label">Renegade CRM</span>
            <h3>Use the system.</h3>
            <p>Software and playbooks for owners ready to organize and automate their marketing.</p>
            <a href="/crm">Explore CRM →</a>
          </article>
          <article>
            <span class="label">Renegade Academy</span>
            <h3>Build it with us.</h3>
            <p>Live implementation for owners who want help turning strategy into working campaigns and systems.</p>
            <a href="/academy">Explore Academy →</a>
          </article>
          <article>
            <span class="label">Renegade Community</span>
            <h3>Learn with us.</h3>
            <p>Playbooks, Power Hours, experiments, new tech and practical ideas you can use right away.</p>
            <a href="https://community.gorenegades.com">Join free →</a>
          </article>
        </div>
      </div>
    </section>

    <section class="final">
      <div class="wrap final-grid">
        <div>
          <span class="eyebrow light">Marketing Renegades</span>
          <h2>Build a marketing system that fits your business.</h2>
        </div>
        <div>
          <p>Start with the software, get help implementing it, or join the community and learn with us.</p>
          <div class="actions">
            <a class="btn-primary" href="/crm">Explore Renegade CRM</a>
            <a class="btn-outline" href="https://community.gorenegades.com">Join free</a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</div>
</BaseLayout>

<style>
  .light-home{background:#f7f7f5;color:#171717;font-family:var(--body)}
  .hero{padding:96px 0 88px;background:#fff}
  .hero-grid{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(360px,.72fr);gap:88px;align-items:center}
  .eyebrow{display:inline-block;font:700 11px/1 var(--mono);letter-spacing:.12em;text-transform:uppercase;color:#8d7100}
  .hero h1,.section h2,.final h2{font-family:var(--body);font-weight:700;letter-spacing:-.045em;line-height:1.02}
  .hero h1{font-size:clamp(52px,6.1vw,84px);max-width:880px;margin-top:22px;color:#111}
  .lead{font-size:clamp(22px,2vw,28px);line-height:1.45;font-weight:600;max-width:780px;margin-top:30px;color:#2b2b2b}
  .support{font-size:17px;line-height:1.75;max-width:720px;margin-top:18px;color:#666}
  .actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:32px}
  .btn-primary,.btn-secondary,.btn-dark,.btn-outline{display:inline-flex;align-items:center;justify-content:center;min-height:52px;padding:0 22px;border-radius:8px;font-size:14px;font-weight:700}
  .btn-primary{background:#111;color:#fff}
  .btn-primary:hover{background:#2a2a2a}
  .btn-secondary{background:#fff;border:1px solid #cfcfc9;color:#222}
  .btn-secondary:hover{border-color:#111}
  .meta{display:flex;flex-wrap:wrap;gap:8px 18px;margin-top:25px;color:#777;font-size:12px}
  .meta span:before{content:'•';color:#c9a20a;margin-right:8px}

  .overview-card{background:#f4f4f1;border:1px solid #deded8;border-radius:18px;padding:26px}
  .overview-head{padding-bottom:20px;border-bottom:1px solid #d8d8d2}
  .overview-head span{display:block;font:700 9px/1 var(--mono);letter-spacing:.12em;text-transform:uppercase;color:#888}
  .overview-head strong{display:block;font-size:20px;margin-top:7px}
  .overview-list>div{display:grid;grid-template-columns:34px 1fr;gap:14px;padding:18px 0;border-bottom:1px solid #deded8}
  .overview-list>div:last-child{border-bottom:0}
  .overview-list>div>span{font:700 10px/1 var(--mono);color:#a48200;padding-top:5px}
  .overview-list b{display:block;font-size:15px}
  .overview-list small{display:block;color:#777;font-size:12px;margin-top:3px}

  .clarity{background:#f1f1ee;border-block:1px solid #deded8}
  .clarity-grid{display:grid;grid-template-columns:repeat(3,1fr)}
  .clarity-grid>div{padding:26px 28px;border-right:1px solid #d8d8d2}
  .clarity-grid>div:last-child{border-right:0}
  .mini{display:block;font:700 9px/1 var(--mono);letter-spacing:.11em;color:#8d7100;margin-bottom:9px}
  .clarity strong{font-size:14px;line-height:1.45}

  .section{padding:104px 0}
  .white{background:#fff}
  .gray{background:#f3f3f0}
  .section-head{max-width:820px}
  .section h2{font-size:clamp(40px,4.8vw,64px);margin-top:18px;color:#151515}
  .section-head>p,.section-copy{font-size:18px;line-height:1.7;color:#666;max-width:720px;margin-top:22px}

  .outcome-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:48px}
  .outcome-grid article{border:1px solid #dfdfda;border-radius:14px;padding:28px;background:#fff;min-height:220px}
  .num{font:700 10px/1 var(--mono);color:#a48200}
  .outcome-grid h3{font-size:21px;letter-spacing:-.02em;margin-top:30px}
  .outcome-grid p{font-size:14px;line-height:1.7;color:#6e6e6e;margin-top:10px}

  .product-grid{display:grid;grid-template-columns:1fr minmax(320px,.6fr);gap:90px;align-items:center}
  .text-link{display:inline-block;margin-top:28px;color:#111;font-weight:700}
  .price-card{background:#fff;border:1px solid #d8d8d2;border-radius:18px;padding:30px;box-shadow:0 18px 50px rgba(0,0,0,.06)}
  .price-card>span{font:700 10px/1 var(--mono);letter-spacing:.12em;text-transform:uppercase;color:#8d7100}
  .price{font-size:78px;line-height:.95;letter-spacing:-.07em;font-weight:700;margin:22px 0;color:#111}
  .price sup{font-size:28px;vertical-align:top;position:relative;top:6px}
  .price small{font-size:17px;letter-spacing:0;color:#777;margin-left:7px}
  .price-card ul{list-style:none;border-top:1px solid #e5e5e0;padding-top:16px}
  .price-card li{padding:7px 0;color:#555;font-size:14px}
  .btn-dark{width:100%;margin-top:22px;background:#111;color:#fff}

  .paths{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:46px}
  .paths article{border:1px solid #dfdfda;border-radius:14px;padding:28px;background:#fafaf8;min-height:300px;display:flex;flex-direction:column}
  .label{font:700 10px/1 var(--mono);letter-spacing:.11em;text-transform:uppercase;color:#8d7100}
  .paths h3{font-size:26px;letter-spacing:-.03em;margin-top:30px}
  .paths p{font-size:14px;line-height:1.7;color:#666;margin-top:12px}
  .paths a{margin-top:auto;padding-top:30px;color:#111;font-weight:700;font-size:14px}

  .final{padding:88px 0;background:#2b2b2b;color:#fff}
  .final-grid{display:grid;grid-template-columns:1fr .75fr;gap:80px;align-items:center}
  .final h2{font-size:clamp(40px,4.8vw,64px);margin-top:18px}
  .final p{font-size:17px;line-height:1.7;color:#c8c8c8}
  .light{color:#e0bf3c}
  .btn-outline{border:1px solid #666;color:#fff}

  @media(max-width:980px){
    .hero-grid,.product-grid,.final-grid{grid-template-columns:1fr}
    .hero-grid{gap:48px}
    .outcome-grid,.paths{grid-template-columns:1fr 1fr}
    .clarity-grid{grid-template-columns:1fr}
    .clarity-grid>div{border-right:0;border-bottom:1px solid #d8d8d2}
  }
  @media(max-width:640px){
    .hero,.section,.final{padding:72px 0}
    .hero h1{font-size:clamp(44px,12vw,60px)}
    .lead{font-size:20px}
    .outcome-grid,.paths{grid-template-columns:1fr}
    .outcome-grid article,.paths article{min-height:0}
    .btn-primary,.btn-secondary,.btn-outline{width:100%}
  }
</style>