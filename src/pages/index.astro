---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const opportunities = [
  { title: 'Work Your Database', text: 'Stay in touch with the people who already know you — without relying on memory.' },
  { title: 'Generate New Leads', text: 'Launch simple campaigns that create new conversations and opportunities.' },
  { title: 'Follow Up Faster', text: 'Respond, nurture, and keep good leads from quietly disappearing.' },
  { title: 'Get More Reviews & Referrals', text: 'Make asking for reviews and referrals part of the system instead of an afterthought.' },
  { title: 'Create More Content', text: 'Turn one useful idea into more places, more formats, and more consistent visibility.' },
  { title: 'Build Referral Partners', text: 'Create useful, repeatable ways to stay connected with the people who can send business.' }
];
---

<BaseLayout
  title="Marketing Renegades | You're Closer Than You Think"
  description="Marketing Renegades helps independent business owners use simple systems, software, playbooks, and live implementation to market more consistently."
>
  <div class="page">
    <Header ctaLabel="Get Renegade CRM" ctaHref="/crm" />

    <main>
      <section class="hero home-hero">
        <div class="hero-glow"></div>
        <div class="wrap hero-in">
          <span class="ey">A pretty incredible time to own a small business.</span>
          <h1 class="disp home-title">
            <span>You're closer</span>
            <span class="gold">than you think.</span>
          </h1>
          <p class="hero-tag">
            You don't need a giant marketing department, ten different tools,
            or some secret strategy.
          </p>
          <p class="hero-sub home-lead">
            Today, an independent business owner can build a remarkably powerful
            marketing system faster, easier, and cheaper than ever before.
            Renegades helps you make sense of the opportunity — then gives you
            the tools, playbooks, and people to put it to work.
          </p>
          <div class="hero-cta">
            <a href="#possible" class="btn btn-gold">See what's possible <span class="ar">→</span></a>
            <a href="https://community.gorenegades.com" class="btn btn-ghost">Join the Renegades — Free</a>
          </div>
          <div class="hero-proof">
            <span>Simple systems.</span>
            <span>Serious leverage.</span>
            <span>Start with one thing.</span>
          </div>
        </div>
      </section>

      <section class="sec sec-ink" id="possible">
        <div class="wrap">
          <div class="split-intro rv">
            <div>
              <span class="ey">The opportunity</span>
              <h2 class="disp">Marketing got a whole lot <span class="g">easier.</span></h2>
            </div>
            <div class="intro-copy">
              <p>Not because marketing magically became easy. Because the leverage changed.</p>
              <p>
                Automation, AI, inexpensive software, email, text, content,
                online communities, and better tools have put capabilities
                inside a small business that used to require a department.
              </p>
              <p class="bright">
                The question isn't whether you can do all of it.
                It's what you want to make work first.
              </p>
            </div>
          </div>

          <div class="capability-grid rv">
            <div class="capability">Follow up with every lead.</div>
            <div class="capability">Email your database consistently.</div>
            <div class="capability">Turn one idea into more content.</div>
            <div class="capability">Ask every customer for a review.</div>
            <div class="capability">Respond to missed calls faster.</div>
            <div class="capability">Book appointments automatically.</div>
          </div>

          <div class="permission rv">
            <span class="ey">The Renegade approach</span>
            <h3 class="disp">You don't have to do all of this today.</h3>
            <p>Start with one thing. Get it working. Add the next. <strong>That's the whole idea.</strong></p>
          </div>
        </div>
      </section>

      <section class="sec sec-black">
        <div class="wrap">
          <div class="section-center rv">
            <span class="ey">Three ways to use Renegades</span>
            <h2 class="disp">The system. The build. <span class="g">The community.</span></h2>
            <p class="sec-lead">Pick the level of help you want. Everything is designed to work together.</p>
          </div>

          <div class="renegade-grid rv">
            <article class="renegade-card">
              <div class="card-top">
                <span class="card-number">01</span>
                <span class="card-label">Renegade CRM</span>
              </div>
              <h3 class="disp">Put the machine in place.</h3>
              <p>
                Your marketing system for <strong>$99/month</strong>.
                CRM, automation, email, text, pipelines, reviews, calendars,
                social tools, AI, and more — in one place.
              </p>
              <a href="/crm" class="text-link">Get Renegade CRM →</a>
            </article>

            <article class="renegade-card featured">
              <div class="card-top">
                <span class="card-number">02</span>
                <span class="card-label">Renegade Academy</span>
              </div>
              <h3 class="disp">Build it with us.</h3>
              <p>
                Live classes, real implementation, strategy, troubleshooting,
                and classmates. We don't just talk about the system.
                We build it into your actual business.
              </p>
              <a href="/academy" class="text-link">Explore the Academy →</a>
            </article>

            <article class="renegade-card">
              <div class="card-top">
                <span class="card-number">03</span>
                <span class="card-label">Renegade Community</span>
              </div>
              <h3 class="disp">Come steal our ideas.</h3>
              <p>
                Playbooks. Power Hours. Templates. Experiments. New tech.
                Guest experts. And other business owners figuring this stuff
                out right alongside you.
              </p>
              <a href="https://community.gorenegades.com" class="text-link">Join Free →</a>
            </article>
          </div>
        </div>
      </section>

      <section class="sec sec-ink system-sec">
        <div class="wrap">
          <div class="system-head rv">
            <span class="ey">This is the part that still blows my mind</span>
            <h2 class="disp">The whole system starts at <span class="g">$99/month.</span></h2>
            <p class="sec-lead">
              Not $99 for another course. $99 for the software that runs the system —
              plus Renegade playbooks that show you what to do with it.
            </p>
          </div>

          <div class="opportunity-question rv">
            <span class="mono">START HERE</span>
            <h3>What do you want this machine to do for you first?</h3>
          </div>

          <div class="opportunity-grid rv">
            {opportunities.map((item, i) => (
              <article class="opp-card">
                <span class="opp-num">{String(i + 1).padStart(2, '0')}</span>
                <h4>{item.title}</h4>
                <p>{item.text}</p>
              </article>
            ))}
          </div>

          <div class="system-cta rv">
            <div>
              <span class="ey">Renegade CRM</span>
              <h3 class="disp">$99/month. Software included.</h3>
            </div>
            <a href="/crm" class="btn btn-gold">See Renegade CRM <span class="ar">→</span></a>
          </div>
        </div>
      </section>

      <section class="band belief-band">
        <div class="wrap">
          <span class="ey dark-ey">The bigger idea</span>
          <h2 class="disp">Capability changes everything.</h2>
          <p>
            We teach what we know, build alongside you, and bring in specialists
            when they're the better person to learn from. The goal isn't to make
            you dependent on Renegades. It's to make you more capable.
          </p>
        </div>
      </section>

      <section class="sec sec-black final-home">
        <div class="narrow rv">
          <span class="ey">Not ready to buy anything?</span>
          <h2 class="disp">Come hang out with the <span class="g">Renegades.</span></h2>
          <p class="sec-lead">
            Get the playbooks. Come to the Power Hours. See the ideas we're testing.
            Learn from the community. Use whatever helps.
          </p>

          <div class="community-pills">
            <span>Playbooks</span>
            <span>Power Hours</span>
            <span>Templates</span>
            <span>New Tech</span>
            <span>Guest Experts</span>
            <span>Nerd Nights</span>
          </div>

          <div class="hero-cta center-cta">
            <a href="https://community.gorenegades.com" class="btn btn-gold">
              Join the Renegades — Free <span class="ar">→</span>
            </a>
          </div>

          <p class="closing-line">You're probably a lot closer than you think.</p>
        </div>
      </section>
    </main>

    <Footer />
  </div>
</BaseLayout>

<style>
  .home-hero { min-height: 760px; display: flex; align-items: center; }
  .home-title { font-size: clamp(72px, 14vw, 190px); max-width: 1100px; }
  .home-title span { display: block; }
  .home-title .gold { color: var(--gold); }
  .home-lead { max-width: 760px; }

  .hero-proof {
    display: flex; flex-wrap: wrap; gap: 12px 28px; margin-top: 34px;
    font-family: var(--mono); font-size: 11px; letter-spacing: .12em;
    text-transform: uppercase; color: var(--smoke-dim);
  }

  .split-intro {
    display: grid; grid-template-columns: 1.15fr .85fr;
    gap: 80px; align-items: start;
  }

  .split-intro h2 { max-width: 760px; }
  .intro-copy { padding-top: 52px; }

  .intro-copy p {
    color: var(--smoke); font-size: 18px; line-height: 1.65; margin-bottom: 20px;
  }

  .intro-copy .bright { color: var(--white); font-weight: 600; }

  .capability-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px;
    margin-top: 70px; background: var(--line); border: 1px solid var(--line);
  }

  .capability {
    background: var(--black); padding: 30px 26px; font-family: var(--display);
    text-transform: uppercase; font-size: clamp(23px, 2.5vw, 34px); line-height: 1;
  }

  .capability::before { content: '+'; color: var(--gold); margin-right: 12px; }

  .permission {
    margin-top: 64px; border-left: 4px solid var(--gold);
    padding: 8px 0 8px 30px; max-width: 800px;
  }

  .permission h3 { font-size: clamp(34px, 5vw, 62px); margin-top: 12px; }
  .permission p { color: var(--smoke); font-size: 18px; margin-top: 14px; }
  .permission strong { color: var(--white); }

  .section-center { max-width: 880px; margin: 0 auto; text-align: center; }
  .section-center .sec-lead { margin-left: auto; margin-right: auto; }

  .renegade-grid {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 18px; margin-top: 58px;
  }

  .renegade-card {
    min-height: 430px; border: 1px solid var(--line); padding: 34px 30px;
    background: var(--ink); display: flex; flex-direction: column;
    transition: transform .2s ease, border-color .2s ease;
  }

  .renegade-card:hover { transform: translateY(-5px); border-color: var(--gold); }

  .renegade-card.featured {
    border: 2px solid var(--gold); background: rgba(244,194,13,.045);
  }

  .card-top {
    display: flex; justify-content: space-between; gap: 20px;
    align-items: center; margin-bottom: 44px;
  }

  .card-number {
    font-family: var(--display); font-size: 34px;
    color: var(--gold); line-height: .8;
  }

  .card-label {
    font-family: var(--mono); font-size: 10px; letter-spacing: .15em;
    text-transform: uppercase; color: var(--smoke);
  }

  .renegade-card h3 {
    font-size: clamp(34px, 3.4vw, 50px); margin-bottom: 20px;
  }

  .renegade-card p {
    color: var(--smoke); line-height: 1.6; font-size: 16px; margin-bottom: 30px;
  }

  .renegade-card strong { color: var(--white); }

  .text-link {
    margin-top: auto; color: var(--gold); font-family: var(--mono);
    font-weight: 700; font-size: 13px; letter-spacing: .04em;
    text-transform: uppercase;
  }

  .system-head { max-width: 900px; }

  .opportunity-question {
    margin-top: 64px; padding: 28px 30px; background: var(--gold);
    color: var(--black); display: flex; gap: 28px; align-items: center;
  }

  .opportunity-question .mono {
    font-size: 11px; font-weight: 700; letter-spacing: .14em;
  }

  .opportunity-question h3 {
    font-family: var(--display); text-transform: uppercase;
    font-size: clamp(26px, 3vw, 40px); line-height: 1;
  }

  .opportunity-grid {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 18px; margin-top: 18px;
  }

  .opp-card {
    border: 1px solid var(--line); background: var(--black); padding: 28px 26px;
  }

  .opp-num {
    display: block; font-family: var(--display); font-size: 28px;
    color: var(--gold); margin-bottom: 20px;
  }

  .opp-card h4 {
    font-family: var(--display); text-transform: uppercase;
    font-size: 27px; line-height: 1; margin-bottom: 12px;
  }

  .opp-card p { color: var(--smoke); font-size: 14.5px; line-height: 1.5; }

  .system-cta {
    margin-top: 54px; padding-top: 40px; border-top: 1px solid var(--line);
    display: flex; justify-content: space-between; align-items: center; gap: 30px;
  }

  .system-cta h3 {
    font-size: clamp(38px, 5vw, 66px); margin-top: 10px;
  }

  .belief-band { text-align: left; }
  .belief-band .wrap { max-width: 1000px; }
  .belief-band h2 { margin-top: 14px; }

  .belief-band p {
    max-width: 760px; margin-left: 0; margin-right: 0;
    font-family: var(--body); text-transform: none; letter-spacing: 0;
    font-size: 19px; line-height: 1.65;
  }

  .dark-ey { color: var(--black); opacity: .7; }
  .final-home { text-align: center; }
  .final-home .sec-lead { margin-left: auto; margin-right: auto; }

  .community-pills {
    display: flex; flex-wrap: wrap; justify-content: center;
    gap: 10px; margin-top: 36px;
  }

  .community-pills span {
    border: 1px solid var(--line); padding: 10px 15px; font-family: var(--mono);
    font-size: 11px; text-transform: uppercase; letter-spacing: .09em;
    color: var(--smoke);
  }

  .center-cta { justify-content: center; }

  .closing-line {
    margin-top: 34px; font-family: var(--display); text-transform: uppercase;
    font-size: clamp(28px, 4vw, 48px); color: var(--gold);
  }

  @media (max-width: 900px) {
    .split-intro { grid-template-columns: 1fr; gap: 20px; }
    .intro-copy { padding-top: 0; }
    .capability-grid, .renegade-grid, .opportunity-grid { grid-template-columns: 1fr 1fr; }
    .renegade-card { min-height: 360px; }
  }

  @media (max-width: 640px) {
    .home-hero { min-height: auto; }
    .home-title { font-size: clamp(62px, 20vw, 100px); }
    .capability-grid, .renegade-grid, .opportunity-grid { grid-template-columns: 1fr; }
    .opportunity-question { align-items: flex-start; flex-direction: column; gap: 8px; }
    .system-cta { align-items: flex-start; flex-direction: column; }
    .renegade-card { min-height: auto; }
  }
</style>
