---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import HeroVideo from '../components/HeroVideo.astro';
import Footer from '../components/Footer.astro';
import Pricing from '../components/Pricing.astro';
import Faq from '../components/Faq.astro';
import { links } from '../lib/links.js';
import { brand, semester, academyPrice } from '../lib/site.js';
import '../styles/renegade-home.css';

const jobs = [
  ['More leads turning into conversations', 'Respond quickly, follow up consistently and give every good lead a better chance to become a customer.'],
  ['More value from the people you already know', 'Stay connected to past customers, prospects and referral partners with simple, consistent communication.'],
  ['More reviews and referrals', 'Make it easy to ask at the right moment and keep great customer experiences working for your business.'],
  ['More appointments on the calendar', 'Give people a simple way to book time and keep the process moving without extra back-and-forth.'],
  ['More opportunities captured', 'Turn missed calls, website inquiries and new contacts into real conversations instead of loose ends.'],
  ['More visibility from the ideas you already have', 'Use AI and smart workflows to turn one useful idea into emails, posts and content across multiple channels.']
];

const faqs: [string, string][] = [
  ['Do I need to be technical?', "No. The playbooks walk you through one system at a time in plain English. If you can send an email and fill out a form, you can run this. And if you'd rather have help, that's exactly what Academy is for."],
  ['Who is this for?', 'Entrepreneurs and small business owners who want a more capable, consistent business using better systems, modern tools and automation. We started with mortgage and real estate professionals, and the same ideas work for service businesses, local businesses and independent operators.'],
  ["What's the difference between the CRM and Academy?", "Renegade CRM is the software plus the playbooks, and you can build at your own pace. Academy includes the CRM and adds an 8-week live semester where you build the system with us, step by step. Graduates join the Renegade Alumni."],
  ['Is Renegade CRM just software?', "No. The software is the toolbox. The playbooks show you where to start, what to build and how to put the tools to work in your business."],
  ["I already have a CRM. Should I switch?", "Maybe, maybe not. Bring the question to a free Power Hour and we'll talk it through honestly. If what you have is working, keep it and use the ideas that help."],
  ['Can I start for free?', 'Yes. Join the Renegade Community for free, come to a Power Hour and explore the ideas. When you are ready for the system, Renegade CRM is $99 a month.']
];
---

<BaseLayout
  title="Marketing Renegades | No Fear Marketing."
  description="We help entrepreneurs solve marketing and growth problems using smarter systems, tools and automation. Explore Renegade CRM, Academy and the free Community."
>
  <div class="page r-home">
    <Header ctaLabel="Join the Renegades" ctaHref="#pricing" />
    <main>
      <section class="r-hero" aria-labelledby="hero-heading">
        <HeroVideo />
        <div class="p-wrap r-hero-copy">
          <span class="p-eyebrow">No Fear Marketing.</span>
          <h1 id="hero-heading">Marketing<br /><span>Renegades.</span></h1>
          <p class="r-subhead">Powerful marketing tools. Practical systems.<br />Built for entrepreneurs.</p>
          <p class="r-hero-line">We help entrepreneurs solve marketing and growth problems using smarter systems, tools and automation.</p>
          <div class="p-btns">
            <a class="p-btn p-btn-primary" href="/crm">Explore Renegade CRM →</a>
            <a class="p-btn p-btn-secondary" href="#how-it-works">See how it works</a>
          </div>

        </div>
      </section>

      <section class="p-sec r-crm" id="renegade-crm" aria-labelledby="crm-heading">
        <div class="p-wrap">
          {brand.homeOffers.crm.src && <img class="r-crm-banner" src={brand.homeOffers.crm.src} alt={brand.homeOffers.crm.alt} width="1128" height="191" loading="lazy" />}
          <div class="p-split">
            <div>
              <span class="p-eyebrow">Renegade CRM / The tools + the playbooks</span>
              <h2 class="p-h2" id="crm-heading">RENEGADE CRM<br /><span class="r-gold">Your Secret Weapon.</span></h2>
              <p class="p-lead">AI-powered business operating system that handles what you need RIGHT NOW and grows as fast as you need it.</p>
              <div class="p-body">
                <p>All the cool stuff you need. Contacts. Follow-up. Email. Texting. Appointments. Reviews. Content. AI. All connected, so every opportunity has somewhere to go.</p>
                <p>Lots of great tools, but solve your biggest problem first, then grow from there. One powerful system, with practical playbooks that show you what to turn on first and connected tools ready for your next move.</p>
                <p><strong>Big performers need big systems to reach the masses.</strong></p>
              </div>
              <div class="p-btns"><a class="p-btn p-btn-primary" href="/crm">Explore Renegade CRM →</a></div>
            </div>
            <div class="r-command-panel">
              <span class="p-eyebrow">Renegade CRM</span>
              <div class="r-price">$99<span>/ month</span></div>
              <p>The software. The playbooks. Room to grow.</p>
              <div class="r-tool-grid"><span>Contacts + pipelines</span><span>Email + text</span><span>Lead follow-up</span><span>Calendars + booking</span><span>Reviews + referrals</span><span>Funnels + landing pages</span><span>Social scheduling</span><span>AI + automation</span></div>
              <a class="p-link" href="/crm">See everything inside →</a>
            </div>
          </div>
        </div>
      </section>

      <section class="p-sec r-academy" id="renegade-academy" aria-labelledby="academy-heading">
        <div class="p-wrap">
          <div class="r-section-top"><span class="p-eyebrow">Renegade Academy</span><span class="r-stamp">Find your people.</span></div>
          <div class="p-split">
            <div>
              <h2 class="p-h2" id="academy-heading">Renegade Academy<br />Live, private classes <br /><span class="r-gold">Graduate with Fellow renegades.</span></h2>
              <p class="p-lead">Live classes by semester with fellow Renegades. Graduate and become a Renegade Alumni.</p>
              <div class="p-body">
                <p>Join other Renegades in an eight-week live semester working together to systems and strategies.  Same weekly meetup. Real business owners bringing their questions, sharing ideas and building alongside you.</p>
                <p>Get a clear place to start and people to move forward with. Each week we put another piece to work in your business. Come and ask questions, compare notes, celebrate progress and get help in the build lab. Mixer and Nerd Night included!</p>
                <p><strong>Renegade CRM is included, great friendships are highly likely.</strong> Graduates keep the connection going in the private Renegade Alumni group.</p>
              </div>
              <div class="p-btns"><a class="p-btn p-btn-primary" href="/academy">Join the next semester →</a></div>
            </div>
            <div class="r-cohort-panel">
              {brand.homeOffers.academy.src && <img class="r-academy-banner" src={brand.homeOffers.academy.src} alt={brand.homeOffers.academy.alt} width="1024" height="401" loading="lazy" />}
              <span class="p-eyebrow">Renegade Academy</span>
              <div class="r-price">${academyPrice.monthly}<span>/ month</span></div>
              <p class="r-panel-description">The CRM. The semester. Your fellow Renegades.</p>
              <div class="r-cohort-facts"><div><strong>8</strong><span>Live weekly classes</span></div><div><strong>{semester.seats}</strong><span>Seats per cohort</span></div></div>
              <ul class="p-checks"><li>Classmates to learn with and bounce ideas off.</li><li>A weekly plan to build working systems in your business.</li><li>A build lab to work through questions together.</li><li>Alumni connection that keeps going after graduation.</li></ul>
              <a class="p-link" href="/academy">See the semester courses and schedule.→</a>
            </div>
          </div>
        </div>
      </section>

      <section class="p-sec r-community" id="renegade-community" aria-labelledby="community-heading">
        <div class="p-wrap p-split">
          <div>
            <span class="p-eyebrow">Renegade Community / Free to join</span>
            <h2 class="p-h2" id="community-heading">Free Renegade Community<br />Discussions, playbooks, and shenanigans<br /><span class="r-gold">Join Today</span></h2>
            <p class="p-lead">Jump on our live calls, get ideas, unleash your Renegade</p>
            <div class="p-body"><p>Bring a questions, share a wins (and losses). Feel free to grab a playbook. Meet entrepreneurs trying new things and helping each other move forward.</p><p>Weekly Power Hours, templates, guest perspectives and experiments with new tools, AI and automation. Useful ideas, real conversations and room to make friends along the way.</p></div>
            <div class="p-btns"><a class="p-btn p-btn-primary" href="/community">Join the free community →</a><a class="p-btn p-btn-secondary" href={links.powerHour}>Next Power Hour Call</a></div>
          </div>
          <div class="r-command-panel r-community-panel">
            <span class="p-eyebrow">Renegade Community</span>
            <div class="r-price">FREE</div>
            <p>Ideas. Playbooks. People worth knowing.</p>
            <div class="r-tool-grid"><span>Weekly Power Hours</span><span>Playbooks + templates</span><span>AI + tool experiments</span><span>Renegade shenanigans</span></div>
            <a class="p-link" href={links.community}>Join the Renegades. Pleased to meet you! →</a>
          </div>
        </div>
      </section>

      <section class="p-sec r-transformation" aria-labelledby="transformation-heading">
        <div class="p-wrap">
          <span class="p-eyebrow">The next chapter is yours.</span>
          <h2 class="p-h2" id="transformation-heading">You're already a RENEGADE.<br /><span>We just help you unlock it.</span></h2>
          <p class="r-manifesto">You've got a song to sing,<br />you just need the masses to hear it.</p>
          <div class="p-grid-3">
            <article><span class="r-index">01 / The system</span><h3 class="p-h3">Renegade CRM</h3><p>You bring the voice. The CRM brings the amps, the connections and the follow-up. Put your ideas in front of more people, then keep the conversation going.</p><a class="p-link" href="/crm">Plug into the system →</a></article>
            <article><span class="r-index">02 / The brainiac</span><h3 class="p-h3">Renegade Academy</h3><p>Join the semester. Make connections. Feed your Renegade brainiac with new ideas, live classes and a crew that builds alongside you. Mixer and Nerd Night included.</p><a class="p-link" href="/academy">Find your semester →</a></article>
            <article><span class="r-index">03 / The Renegade within</span><h3 class="p-h3">Renegade Community</h3><p>Got an idea you want to try? Bring it. Swap stories, experiment with the crew and give that Renegade streak some room to run. The door's open.</p><a class="p-link" href={links.community}>Unleash your Renegade →</a></article>
          </div>
        </div>
      </section>

      <section class="p-sec r-how" id="how-it-works">
        <div class="p-wrap">
          <div class="p-head"><span class="p-eyebrow">How it works</span><h2 class="p-h2">Start simple. Get one thing working.<br />Add the next piece. <span class="r-gold">Renegade CRM grows with you.</span></h2></div>
          <div class="p-grid-3" style="margin-top:40px">
            <article class="p-card"><span class="p-num">1</span><h3 class="p-h3">Pick a playbook</h3><p>Choose a Renegade playbook for the result you want. It lays out the tools, the steps and an example you can make your own.</p></article>
            <article class="p-card"><span class="p-num">2</span><h3 class="p-h3">Get one thing working</h3><p>Follow the steps, put it to work and see what happens. Make a few adjustments until it fits the way you run your business.</p></article>
            <article class="p-card"><span class="p-num">3</span><h3 class="p-h3">Add the next piece</h3><p>Keep what works and build on it. The connected tools are ready whenever your next idea is.</p></article>
          </div>
        </div>
      </section>

      <section class="p-sec" id="bottlenecks">
        <div class="p-wrap">
          <div class="p-head"><span class="p-eyebrow">Pick your first win.</span><h2 class="p-h2">What's your biggest bottleneck?</h2><p class="p-lead">Where's the biggest opportunity? More repeat business, stronger relationships, a clearer online presence or faster follow-up. Choose the area that could make the biggest difference.</p></div>
          <div class="p-grid-3" style="margin-top:40px">{jobs.map(([title, text], i) => (<article class="p-card"><span class="p-num">{i + 1}</span><h3 class="p-h3">{title}</h3><p>{text}</p></article>))}</div>
        </div>
      </section>

      <section class="p-sec" id="pricing">
        <div class="p-wrap"><div class="p-head"><span class="p-eyebrow">Three ways to join the Renegades</span><h2 class="p-h2">Unleash your inner Renegade.</h2></div><Pricing /></div>
      </section>

      <section class="p-sec r-faq"><div class="p-narrow"><span class="p-eyebrow">Straight answers</span><h2 class="p-h2">Before you jump in.</h2><Faq items={faqs} /></div></section>

      <section class="p-sec r-final"><div class="p-wrap"><span class="p-eyebrow">No Fear Marketing.</span><h2 class="p-h2">You've got a song to sing,<br /><span class="r-gold">let the world hear it.</span></h2><p class="p-lead">Explore the CRM, build with Academy, or join the free Community.<br />Choose the next step that fits your business.</p><div class="p-btns"><a class="p-btn p-btn-primary" href="#pricing">Join the Renegades →</a><a class="p-btn p-btn-secondary" href="/community">Start with the free crew</a></div></div></section>
    </main>
    <Footer />
  </div>
</BaseLayout>
