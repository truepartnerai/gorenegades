---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout title="About Marketing Renegades — Marketing Renegades" description="Why Marketing Renegades exists, what we believe, and Darin Rhodes' role as teacher, strategist, facilitator, and convener.">
  <div class="page">
    <Header />
    <main class="sec sec-black" style="min-height:70vh">
      <div class="wrap rv">
        <span class="ey">Marketing Renegades</span>
        <h1 class="disp" style="font-size:clamp(58px,10vw,150px);margin-top:20px">About Marketing Renegades</h1>
        <p class="hero-sub">Why Marketing Renegades exists, what we believe, and Darin Rhodes' role as teacher, strategist, facilitator, and convener.</p>
      </div>
    </main>
    <Footer />
  </div>
</BaseLayout>
