---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout title="Renegade Top 40 — Marketing Renegades" description="A serious working group for independent mortgage brokerage owners building companies beyond their own personal production.">
  <div class="page">
    <Header />
    <main class="sec sec-black" style="min-height:70vh">
      <div class="wrap rv">
        <span class="ey">Marketing Renegades</span>
        <h1 class="disp" style="font-size:clamp(58px,10vw,150px);margin-top:20px">Renegade Top 40</h1>
        <p class="hero-sub">A serious working group for independent mortgage brokerage owners building companies beyond their own personal production.</p>
      </div>
    </main>
    <Footer />
  </div>
</BaseLayout>
