---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout title="Renegade Top 40 — Marketing Renegades" description="A serious working group for independent mortgage brokerage owners building companies beyond their own personal production.">
  <div class="page">
    <Header />
    <main class="p-hero" style="min-height:60vh">
      <div class="p-narrow">
        <span class="p-eyebrow">Marketing Renegades</span>
        <h1 class="p-h1">Renegade Top 40</h1>
        <p class="p-lead">A serious working group for independent mortgage brokerage owners building companies beyond their own personal production.</p>
      </div>
    </main>
    <Footer />
  </div>
</BaseLayout>
