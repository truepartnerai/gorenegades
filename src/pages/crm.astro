---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Faq from '../components/Faq.astro';
import { links } from '../lib/links.js';
import Banner from '../components/Banner.astro';
import { brand } from '../lib/site.js';

const features = [
  ['Contacts, CRM and pipelines', 'Every lead, customer and referral partner in one place, with a clear view of where each one stands.'],
  ['Email and text', 'Two-way conversations from one inbox, plus campaigns that keep your database warm.'],
  ['Automated follow-up', 'New leads get an instant response and a follow-up sequence that keeps going until they reply.'],
  ['Calendars and booking', 'A booking link with reminders, so appointments land on your calendar and actually show up.'],
  ['Reviews and referrals', 'Automatic review requests after every job, and a simple way to ask for introductions.'],
  ['Missed-call text back', 'Miss a call and the caller gets a text right away, so the lead stays yours.'],
  ['Funnels and landing pages', 'Simple pages and forms that capture leads and drop them straight into follow-up.'],
  ['Social and AI tools', 'Schedule posts, draft content and replies faster with built-in AI.']
];

const playbooks = [
  'Speed-to-lead follow-up',
  'Monthly database email',
  'Review requests on autopilot',
  'Missed-call text back',
  'Referral partner check-ins',
  'One idea, a week of content'
];

const faqs: [string, string][] = [
  ['What exactly do I get for $99?', 'The full Renegade CRM software, the Renegade playbooks that walk you through setting up each system, templates you can copy, and access to the free Renegade Community and Power Hours.'],
  ['Do I need to be technical?', "No. The playbooks are written for business owners, not IT departments. Start with one system, follow the steps and you're running."],
  ['Is there an annual option?', 'Yes. Pay $999 for the year and save $189 compared to paying monthly.'],
  ['What if I want help setting it up?', "That's Renegade Academy. It includes the CRM and adds an 8-week live semester where you build your system alongside a class of other business owners, for $199 a month."],
  ['What kinds of businesses use it?', 'Any business that grows through leads, follow-up, relationships and referrals: mortgage and real estate professionals, service businesses, local shops, consultants and solo operators.']
];
---

<BaseLayout
  title="Renegade CRM | Your Marketing System for $99/Month"
  description="Renegade CRM gives entrepreneurs the software and the playbooks to automate follow-up, work their database, get reviews and stay visible, for $99/month."
>
  <div class="page">
    <Header />
    <Banner src={brand.banners.crm} alt="Renegade CRM" />

    <main>
      <section class="p-hero">
        <div class="p-wrap">
          <span class="p-eyebrow">Renegade CRM · $99/month</span>
          <h1 class="p-h1">The software and the playbook, <span class="p-hl">together</span>.</h1>
          <p class="p-lead">Most business owners already own software they don't use. Renegade CRM gives your marketing somewhere to live, then the Renegade playbooks show you exactly what to switch on first so it actually gets used.</p>
          <div class="p-btns">
            <a class="p-btn p-btn-primary" href={links.crmMonthly} rel="noopener">Start for $99/mo</a>
            <a class="p-btn p-btn-secondary" href="#inside">See what's inside</a>
          </div>
          <div class="p-assure">
            <span>All the tools in one login</span>
            <span>Step-by-step playbooks</span>
            <span>Free community included</span>
          </div>
        </div>
      </section>

      <section class="p-sec" id="inside">
        <div class="p-wrap">
          <div class="p-head">
            <span class="p-eyebrow">What's inside</span>
            <h2 class="p-h2">Everything your marketing needs to run, in one place.</h2>
          </div>
          <div class="p-grid-2" style="margin-top:40px">
            {features.map(([title, text]) => (
              <article class="p-card">
                <h3 class="p-h3">{title}</h3>
                <p>{text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="p-sec p-sec-alt">
        <div class="p-wrap p-split">
          <div>
            <span class="p-eyebrow">The part other software skips</span>
            <h2 class="p-h2">Playbooks that tell you what to do with it.</h2>
            <div class="p-body">
              <p>Software on its own is a gym membership. It feels great the day you sign up and then quietly bills you every month. The difference with Renegade CRM is that it comes with a plan.</p>
              <p>Each playbook takes one marketing job, tells you why it matters, and walks you through turning it on inside the CRM. Do one, get it working, then add the next.</p>
            </div>
          </div>
          <div>
            <ul class="p-checks">
              {playbooks.map((item) => <li>{item}</li>)}
            </ul>
            <p class="p-small" style="margin-top:18px">New playbooks get added as we test what works.</p>
          </div>
        </div>
      </section>

      <section class="p-sec" id="start">
        <div class="p-wrap p-offer">
          <div>
            <span class="p-eyebrow">Get started</span>
            <h2 class="p-h2">One system. One price. Start today.</h2>
            <ul class="p-checks">
              <li>Renegade CRM software</li>
              <li>Renegade marketing playbooks</li>
              <li>Templates and examples to copy</li>
              <li>Free Renegade Community and weekly Power Hours</li>
            </ul>
          </div>
          <aside class="p-offer-box">
            <div class="pp-name">Renegade CRM</div>
            <div class="pp-price"><strong>$99</strong><span>/ month</span></div>
            <p class="pp-desc" style="margin-bottom:22px">The marketing system plus the software.</p>
            <a class="p-btn p-btn-primary p-btn-block" href={links.crmMonthly} rel="noopener">Start for $99/mo</a>
            <span class="pp-alt">Or <a href={links.crmAnnual} rel="noopener">pay $999 for the year</a> and save $189.</span>
          </aside>
        </div>
      </section>

      <section class="p-sec p-sec-alt">
        <div class="p-wrap">
          <div class="p-callout" style="margin-top:0">
            <div>
              <strong>Rather not build it alone?</strong>
              <p>Renegade Academy includes the CRM and adds an 8-week live semester where you and your classmates build the system together. $199/month.</p>
            </div>
            <a class="p-btn p-btn-primary" href="/academy">See the semester</a>
          </div>
        </div>
      </section>

      <section class="p-sec">
        <div class="p-narrow">
          <span class="p-eyebrow">Quick answers</span>
          <h2 class="p-h2">Questions about Renegade CRM</h2>
          <Faq items={faqs} />
        </div>
      </section>

      <section class="p-sec p-sec-dark">
        <div class="p-narrow p-center">
          <h2 class="p-h2">Make the marketing happen anyway.</h2>
          <p class="p-lead">Even when you're busy, even when you forget, even when you'd rather be with customers than staring at a dashboard.</p>
          <div class="p-btns">
            <a class="p-btn p-btn-primary" href={links.crmMonthly} rel="noopener">Start Renegade CRM — $99/mo</a>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </div>
</BaseLayout>
