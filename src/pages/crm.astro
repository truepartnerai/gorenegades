---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const outcomes=[
['Follow up faster','Email, text, tasks and workflows keep leads moving even when you get busy.'],
['Work your database','Stay in front of past clients, prospects and referral partners consistently.'],
['Generate opportunities','Use forms, landing pages, calendars and campaigns to create new conversations.'],
['Get more reviews','Build review requests into the customer journey instead of relying on memory.'],
['Stay visible','Run email and social communication from the same system where your contacts live.'],
['Know what happens next','Pipelines and contact history show who needs attention and where opportunities stand.']
];
const features=['CRM + Contacts','Pipelines','Email Marketing','SMS Messaging','Automations','Calendars','Forms + Surveys','Landing Pages','Funnels','Reviews','Social Planner','AI-Assisted Tools'];
---
<BaseLayout title="Renegade CRM | Marketing System + Software for $99/Month" description="Renegade CRM gives entrepreneurs one place to organize leads, automate follow-up, work their database, request reviews, stay visible and run smarter marketing for $99/month.">
<div class="page crm-v4">
<Header ctaLabel="Join Free" ctaHref="https://community.gorenegades.com" />
<main>
<section class="hero4"><div class="wrap heroGrid">
<div>
<span class="kicker">Renegade CRM</span>
<h1>A simpler way to run <span>your marketing.</span></h1>
<p class="core">Organize leads, automate follow-up, work your database and keep marketing moving from one connected system.</p>
<p class="sub">CRM, email, text, pipelines, automation, calendars, landing pages, reviews, social tools and more — with practical Renegade playbooks showing you what to build first.</p>
<div class="ctas"><a class="primary" href="#start">See the $99 system →</a><a class="secondary" href="#what">What it helps you do</a></div>
<div class="trust"><span>$99/month</span><span>Software included</span><span>Playbooks included</span></div>
</div>
<aside class="panel">
<div class="panelTop"><span>Renegade CRM</span><b>Marketing Command Center</b></div>
<div class="pipeline"><div><span>New lead</span><b>12</b></div><div><span>Following up</span><b>19</b></div><div><span>Appointment</span><b>7</b></div><div class="hot"><span>Opportunity</span><b>8</b></div></div>
<div class="automation"><small>AUTOMATION</small><strong>New lead follow-up</strong><div>✓ Instant text response</div><div>✓ Email follow-up</div><div>✓ Sales task created</div></div>
</aside>
</div></section>

<section class="pain"><div class="wrap painGrid"><span>Leads slipping through?</span><span>Database sitting untouched?</span><span>Marketing happening randomly?</span><span>Too many disconnected tools?</span></div></section>

<section class="section" id="what"><div class="wrap">
<div class="head"><span class="kicker">What it helps you do</span><h2>Features only matter when they fix a real marketing problem.</h2><p>Start with the opportunity you are losing today. Put a repeatable system behind it.</p></div>
<div class="cards">{outcomes.map(([t,d],i)=><article><span>{String(i+1).padStart(2,'0')}</span><h3>{t}</h3><p>{d}</p></article>)}</div>
</div></section>

<section class="gold"><div class="wrap goldGrid">
<div><span class="kicker dark">A lot under one roof</span><h2>Stop stitching your marketing together with five logins and a good memory.</h2><p>Use the pieces that matter now, with the rest ready when your business needs them.</p></div>
<div class="featureGrid">{features.map(f=><span>{f}</span>)}</div>
</div></section>

<section class="section"><div class="wrap split">
<div><span class="kicker">The Renegade difference</span><h2>Software is easy to buy. A working marketing system is different.</h2><p>An empty CRM is another login. Renegade is built around the marketing plays you actually want running in the business.</p></div>
<div class="steps"><div><span>01</span><section><b>The software</b><p>Contacts, communication, campaigns, automation, pipeline, calendars, forms and marketing tools.</p></section></div><div><span>02</span><section><b>The playbooks</b><p>Simple systems for database marketing, leads, follow-up, reviews, referrals and content.</p></section></div><div><span>03</span><section><b>The implementation path</b><p>Use the community or step into Academy when you want more help building the machine.</p></section></div></div>
</div></section>

<section class="offer" id="start"><div class="wrap offerGrid">
<div><span class="kicker dark">Renegade CRM</span><h2>Put the machine in place for <span>$99/month.</span></h2><p>Start with one marketing problem. Build the system. Let it run. Then add the next piece.</p><ul><li>Renegade CRM software</li><li>Marketing playbooks</li><li>Templates and examples</li><li>Free Renegade Community access</li><li>Power Hours and ongoing ideas</li></ul></div>
<aside class="offerCard"><span>RENEGADE CRM</span><div class="price"><sup>$</sup>99<small>/month</small></div><p>The marketing system + the software.</p><a href="https://community.gorenegades.com">Join the Renegades →</a><small>Direct CRM checkout will replace this button when finalized.</small></aside>
</div></section>

<section class="academy"><div class="wrap split"><div><span class="kicker">Want help building it?</span><h2>That is what Renegade Academy is for.</h2></div><div><p>Bring the strategy into a live implementation environment and build the campaigns, workflows and systems into your actual business.</p><a class="primary" href="/academy">Explore Academy →</a></div></div></section>
</main><Footer /></div></BaseLayout>
<style>
.crm-v4{background:#f7f7f5;color:#171717}.kicker{display:inline-flex;align-items:center;gap:9px;font:700 11px/1 var(--mono);letter-spacing:.14em;text-transform:uppercase;color:var(--gold)}.kicker:before{content:'';width:24px;height:2px;background:var(--gold)}
.hero4{padding:88px 0;background:#fff}.heroGrid{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(400px,.75fr);gap:80px;align-items:center}
.hero4 h1,.head h2,.split h2,.gold h2,.offer h2,.academy h2{font-family:var(--body);font-weight:700;letter-spacing:-.05em;line-height:.98}.hero4 h1{font-size:clamp(54px,6.7vw,92px);margin-top:22px}.hero4 h1 span{color:var(--gold)}
.core{font-size:clamp(21px,2vw,27px);line-height:1.4;font-weight:600;max-width:760px;margin-top:30px}.sub{font-size:17px;line-height:1.7;color:#666;max-width:720px;margin-top:18px}
.ctas{display:flex;flex-wrap:wrap;gap:12px;margin-top:32px}.primary,.secondary{display:inline-flex;align-items:center;justify-content:center;min-height:52px;padding:0 22px;border-radius:8px;font-size:15px;font-weight:700}.primary{background:var(--gold);color:#0a0a0a}.secondary{background:#111;color:#171717;border:1px solid #333}.secondary:hover{border-color:var(--gold);color:var(--gold)}
.trust{display:flex;flex-wrap:wrap;gap:10px 22px;color:#777;font-size:12px;margin-top:25px}.trust span:before{content:'•';color:var(--gold);margin-right:8px}
.panel{border:1px solid #deded8;border-radius:16px;background:#f4f4f1;padding:24px;box-shadow:0 30px 80px rgba(0,0,0,.45)}.panelTop{display:flex;justify-content:space-between;border-bottom:1px solid #d8d8d2;padding-bottom:18px}.panelTop span{font:700 9px/1 var(--mono);letter-spacing:.12em;color:var(--gold)}.panelTop b{font-size:13px}
.pipeline{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-top:20px}.pipeline div{background:#fff;border:1px solid #deded8;border-radius:9px;padding:14px}.pipeline .hot{border-color:rgba(244,194,13,.5);background:#fff8d8}.pipeline span{display:block;color:#777;font-size:11px}.pipeline b{display:block;font-size:28px;margin-top:4px}
.automation{margin-top:18px;border-top:1px solid #d8d8d2;padding-top:18px}.automation small{font:700 9px/1 var(--mono);color:#777}.automation strong{display:block;font-size:15px;margin:8px 0 12px}.automation div{font-size:12px;color:#666;padding:6px 0}.automation div:first-letter{color:var(--gold)}
.pain{border-block:1px solid #deded8;background:#f1f1ee}.painGrid{display:grid;grid-template-columns:repeat(4,1fr)}.painGrid span{padding:22px 18px;text-align:center;font-size:12px;color:#666;border-right:1px solid #d8d8d2}.painGrid span:last-child{border-right:0}
.section,.academy{padding:104px 0}.head{max-width:850px}.head h2,.split h2,.academy h2{font-size:clamp(40px,5vw,68px);margin-top:18px}.head p,.split>div>p,.academy p{font-size:18px;line-height:1.7;color:#666;max-width:720px;margin-top:22px}
.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:48px}.cards article{background:#f4f4f1;border:1px solid #222;border-radius:12px;padding:26px}.cards article>span{font:700 10px/1 var(--mono);color:var(--gold)}.cards h3{font-size:22px;margin-top:28px}.cards p{font-size:14px;line-height:1.65;color:#888;margin-top:10px}
.gold,.offer{background:var(--gold);color:#0a0a0a;padding:104px 0}.goldGrid,.split,.offerGrid{display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:start}.dark{color:#0a0a0a}.dark:before{background:#0a0a0a}.gold h2,.offer h2{font-size:clamp(42px,5vw,68px);margin-top:18px}.gold p,.offer p{font-size:17px;line-height:1.65;margin-top:20px;color:#332a08}
.featureGrid{display:grid;grid-template-columns:1fr 1fr;gap:8px}.featureGrid span{background:#0a0a0a;color:#171717;border-radius:8px;padding:14px;font:700 10px/1.4 var(--mono);text-transform:uppercase;letter-spacing:.06em}
.steps{border-top:1px solid #d8d8d2}.steps>div{display:grid;grid-template-columns:56px 1fr;gap:20px;padding:24px 0;border-bottom:1px solid #d8d8d2}.steps>div>span{font:700 11px/1 var(--mono);color:var(--gold);padding-top:5px}.steps b{font-size:18px}.steps p{font-size:14px;line-height:1.6;color:#888;margin-top:6px}
.offer h2 span{display:block}.offer ul{list-style:none;margin-top:26px}.offer li{font-size:15px;font-weight:600;padding:6px 0}.offer li:before{content:'✓';margin-right:10px}
.offerCard{background:#0a0a0a;color:#171717;border-radius:16px;padding:30px}.offerCard>span{font:700 10px/1 var(--mono);letter-spacing:.14em;color:var(--gold)}.price{font-size:86px;font-weight:700;letter-spacing:-.07em;line-height:.9;margin:22px 0}.price sup{font-size:30px;vertical-align:top}.price small{font-size:18px;color:#777;margin-left:8px}.offerCard p{color:#aaa}.offerCard a{display:block;background:var(--gold);color:#0a0a0a;text-align:center;padding:15px;border-radius:8px;font-weight:700;margin-top:24px}.offerCard>small{display:block;color:#666;font-size:10px;line-height:1.5;margin-top:12px}
.academy{background:#f3f3f0}
@media(max-width:980px){.heroGrid,.goldGrid,.split,.offerGrid{grid-template-columns:1fr}.cards{grid-template-columns:1fr 1fr}.painGrid{grid-template-columns:1fr 1fr}}@media(max-width:640px){.hero4,.section,.gold,.offer,.academy{padding:72px 0}.hero4 h1{font-size:clamp(44px,13vw,62px)}.cards,.painGrid,.featureGrid{grid-template-columns:1fr}.painGrid span{border-right:0;border-bottom:1px solid #222}.primary,.secondary{width:100%}}
</style>