---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout title="Renegade CRM — Marketing Renegades" description="The tools and systems that keep marketing, follow-up, communication, and customer relationships in one place.">
  <div class="page">
    <Header />
    <main class="sec sec-black" style="min-height:70vh">
      <div class="wrap rv">
        <span class="ey">Marketing Renegades</span>
        <h1 class="disp" style="font-size:clamp(58px,10vw,150px);margin-top:20px">Renegade CRM</h1>
        <p class="hero-sub">The tools and systems that keep marketing, follow-up, communication, and customer relationships in one place.</p>
      </div>
    </main>
    <Footer />
  </div>
</BaseLayout>
