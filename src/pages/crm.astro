---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Faq from '../components/Faq.astro';
import Banner from '../components/Banner.astro';
import { links } from '../lib/links.js';
import { brand } from '../lib/site.js';

// Optimized from the approved sound-guy MOV supplied for this section.
const soundGuyVideoUrl = '/media/renegade-crm-sound-guy.mp4';
const outcomes = [
  { title: 'Stay Organized', text: 'Know your people, see where opportunities stand and keep the next step clear.', tools: ['Contact manager and smart lists for customers, prospects and partners.', 'Pipelines, opportunities and tasks to see what needs attention.', 'Unified conversations for email, text and customer history.', 'Calendar booking and reminders to make meeting easy.'] },
  { title: 'Get More Business From Past Clients & Contacts', text: 'The people who already know you can be the beginning of your next opportunity. Give those relationships a consistent rhythm.', tools: ['Email campaigns and newsletters for useful updates and offers.', 'Stay-in-touch and reactivation sequences built around your audience.', 'Event invitations, reminders and follow-up to keep the connection going.'] },
  { title: 'Get More Referrals', text: 'Build a repeatable way to nurture the relationships that send business your way.', tools: ['Referral partner tracking using contacts, tags and pipelines.', 'Partner check-ins and introduction requests at meaningful moments.', 'Referral follow-up so you can connect the introduction to the opportunity.'] },
  { title: 'Increase Your Online Presence', text: 'Give your expertise a place to live and your ideas a consistent way to reach people.', tools: ['Social planner for scheduling and publishing across channels.', 'Website builder for a clear online home for your business.', 'Review Engine requests and reputation management to share customer experiences.'] },
  { title: 'Capture & Convert New Opportunities', text: 'Give interested people an easy way to connect, then a clear path from inquiry to conversation to customer.', tools: ['Forms, surveys, funnels and landing pages for focused offers.', 'Missed-call text back and website chat to open the conversation.', 'Ads Manager for campaigns that bring new people into your world.', 'Lead routing and follow-up sequences to keep the next step moving.'] },
  { title: 'AI Agents Help Run the System', text: 'Put AI to work on repeatable tasks, with your voice, instructions and judgment guiding the result.', tools: ['Voice AI / AI receptionist for inbound calls and common questions.', 'Conversation AI to respond to inquiries and help book appointments.', 'Content AI for drafts of emails, posts and campaigns you can review.', 'Workflow AI and agent tools to help build repeatable processes.'] }
];
const included = [
  ['CRM & Organization', ['Contact manager', 'Smart lists, tags and custom fields', 'Pipelines and opportunities', 'Tasks and customer history', 'Unified conversations', 'Mobile app']],
  ['Communication & Booking', ['Email and SMS/text', 'Phone and voicemail', 'Calendars and booking links', 'Appointment reminders', 'Broadcasts and message templates']],
  ['Lead Generation & Websites', ['Website builder', 'Funnels and landing pages', 'Forms and surveys', 'Website chat widget', 'Ads Manager', 'Missed-call text back']],
  ['Database & Relationships', ['Email campaigns and newsletters', 'Automated nurture and reactivation', 'Event invitations and follow-up', 'Referral partner tracking workflows', 'Past-client and partner check-ins']],
  ['Reviews & Reputation', ['Review Engine requests', 'Review campaigns', 'Reputation dashboard', 'Customer follow-up workflows']],
  ['Content & Social', ['Social planner', 'Multi-platform publishing', 'Content scheduling', 'AI writing assistance']],
  ['Automation', ['Workflow builder and triggers', 'Follow-up sequences', 'Appointment automation', 'Lead routing', 'Internal notifications']],
  ['AI Tools & Agents', ['Voice AI / AI receptionist', 'Conversation AI', 'AI-assisted appointment booking', 'Content AI', 'Workflow AI', 'Agent tools']],
  ['Sales & Payments', ['Order forms', 'Invoices and payment links', 'Estimates and proposals', 'Upsell and downsell steps']],
  ['The Renegade Implementation Path', ['Practical playbooks', 'Templates and examples', 'Guidance on what to build first', 'Free Community and Power Hours', 'Academy option for live implementation']]
];
const playbooks = ['Speed-to-lead follow-up', 'Monthly database email', 'Review requests on autopilot', 'Missed-call text back', 'Referral partner check-ins', 'One idea, a week of content'];
const faqs: [string, string][] = [
  ['What is Renegade CRM?', 'The marketing and growth operating system for entrepreneurs. It connects contacts, communication, lead capture, content, reviews, automation and AI, with Renegade playbooks to turn the tools into working systems.'],
  ['What do I get for $99/month?', 'Renegade CRM platform access, practical playbooks, templates and examples, plus access to the free Renegade Community and Power Hours.'],
  ['Do I need to be technical?', 'Start with one business goal. The playbooks explain the steps in plain English, and Community Power Hours are a place to bring questions. Academy adds live training and implementation.'],
  ['Do I have to set up everything at once?', 'No. Identify the bottleneck, choose a playbook and build one useful system. Add the next when you are ready.'],
  ['Is there an annual option?', 'Yes. The annual option is $1,149. Both options are available through the checkout.'],
  ['Is there a contract?', 'The monthly plan has no commitment. You can cancel before your next billing date.'],
  ['What if I want help building it?', 'Renegade Academy includes the CRM and adds an eight-week live semester with training, a build lab and a cohort of entrepreneurs. See the Academy page for current enrollment options.'],
  ['Who is it for?', 'Entrepreneurs who grow through relationships, leads and referrals, including mortgage and real estate professionals, service businesses, local businesses, consultants and independent operators.']
];
---
<BaseLayout title="Renegade CRM | The Marketing & Growth Operating System for Entrepreneurs" description="Connected tools, AI and practical Renegade playbooks. Stay organized, build relationships, capture opportunities and grow one useful system at a time. From $99/month.">
  <div class="page">
    <Header />
    <Banner src={brand.banners.crm} alt="Renegade CRM" />
    <main>
      <section class="p-hero">
        <div class="p-wrap">
          <span class="p-eyebrow">Renegade CRM · $99/month</span>
          <h1 class="p-h1">The marketing and growth<br /><span class="p-hl">operating system for entrepreneurs.</span></h1>
          <p class="p-lead">Renegade CRM brings contacts, communication, content, reviews, lead generation, automation and AI together in one place. Practical Renegade playbooks help you turn those tools into working systems for your business.</p>
          <div class="p-btns"><a class="p-btn p-btn-primary" href={links.crmMonthly} rel="noopener">Start for $99/mo</a><a class="p-btn p-btn-secondary" href="#outcomes">Explore what it can do</a></div>
          <div class="p-assure"><span>Connected tools</span><span>Practical playbooks</span><span>A clear implementation path</span></div>
        </div>
      </section>

      <section class="p-sec p-sec-dark" id="amplify" aria-labelledby="amplify-heading">
        <div class="p-wrap p-split">
          <div>
            <span class="p-eyebrow">The system behind the sound</span>
            <h2 class="p-h2" id="amplify-heading">You've got a song to sing.<br />You just need a system so the masses can hear it.</h2>
            <p class="p-lead">You bring the voice. Renegade CRM is the amplifier.</p>
            <div class="p-body"><p>Your ideas, expertise and relationships are the starting point. Renegade CRM connects the tools that help you reach people, stay in touch and turn interest into opportunity.</p></div>
          </div>
          <div class="crm-amplifier">
            {soundGuyVideoUrl ? <video class="crm-video" controls playsinline preload="metadata" poster="/media/renegade-crm-sound-guy.jpg" aria-label="Renegade CRM: the system behind the sound"><source src={soundGuyVideoUrl} type="video/mp4" />Your browser does not support embedded video.</video> : <div class="crm-stage">{brand.insignia && <img src={brand.insignia} alt="" width="2025" height="2025" loading="lazy" />}<p>You bring the voice.<br /><strong>We'll bring the system.</strong></p></div>}
          </div>
        </div>
      </section>

      <section class="p-sec" id="outcomes">
        <div class="p-wrap">
          <div class="p-head"><span class="p-eyebrow">Find the opportunity</span><h2 class="p-h2">What would make the biggest difference in your business?</h2><p class="p-lead">Start with the outcome. Then put the right tools to work.</p></div>
          <div class="p-grid-2" style="margin-top:40px">{outcomes.map(({title, text, tools}) => <article class="p-card"><h3 class="p-h3">{title}</h3><p>{text}</p><ul class="p-checks crm-tools">{tools.map(tool => <li>{tool}</li>)}</ul></article>)}</div>
        </div>
      </section>

      <section class="p-sec p-sec-alt" id="start-here">
        <div class="p-wrap">
          <div class="p-head"><span class="p-eyebrow">A clear first move</span><h2 class="p-h2">“I don't know where to start.”</h2><p class="p-lead">Start with one opportunity. The system grows with your business.</p></div>
          <div class="p-grid-3" style="margin-top:40px">
            <article class="p-card"><span class="p-num">1</span><h3 class="p-h3">Identify the bottleneck</h3><p>Choose what would help most right now. More repeat business? More referrals? Faster lead response? That goal gives you a starting point.</p></article>
            <article class="p-card"><span class="p-num">2</span><h3 class="p-h3">Choose a Renegade playbook</h3><p>Follow a practical path that explains what to build, why it matters and how to set it up. Use the examples and adapt them to your business.</p></article>
            <article class="p-card"><span class="p-num">3</span><h3 class="p-h3">Build one working system</h3><p>Put it to work, review what happens and improve it. Solve one problem at a time. Add the next system as the business grows.</p></article>
          </div>
          <div class="p-split" style="margin-top:40px"><div><h3 class="p-h3">Tools + playbooks + judgment + a path to implementation.</h3><div class="p-body"><p>The tools give you capability. The playbooks give you a practical starting point. Renegade guidance helps you decide what deserves attention and how to make the pieces work together.</p><p>Bring questions to the free Community and Power Hours, or <a class="p-link" href="/academy">build with us in Renegade Academy →</a>. You become more capable with each system you put to work.</p></div></div><div><span class="p-eyebrow">Practical starting points</span><ul class="p-checks">{playbooks.map(item => <li>{item}</li>)}</ul></div></div>
        </div>
      </section>

      <section class="p-sec" id="inside">
        <div class="p-wrap">
          <div class="p-head"><span class="p-eyebrow">What's Included</span><h2 class="p-h2">The tools for your first system.<br />Room for your next one.</h2><p class="p-lead">A connected platform, organized by capability. Use what helps now and explore the rest as you grow.</p></div>
          <div class="p-grid-3" style="margin-top:40px">{included.map(([title, items]) => <article class="p-card"><h3 class="p-h3">{title}</h3><ul class="p-checks">{Array.isArray(items) && items.map(item => <li>{item}</li>)}</ul></article>)}</div>
          <p class="p-small" style="margin-top:24px">Academy adds live implementation through a separate enrollment. Explore the Academy page for details.</p>
          <div class="p-btns" style="margin-top:20px"><a class="p-link" href="/crm/solutions">Explore 72 business scenarios →</a><a class="p-link" href="/crm/compare">Compare Renegade CRM to other platforms →</a></div>
        </div>
      </section>

      <section class="p-sec p-sec-alt" id="start">
        <div class="p-wrap p-offer"><div><span class="p-eyebrow">Get started</span><h2 class="p-h2">Find the opportunity.<br />Build the system.</h2><ul class="p-checks"><li>Renegade CRM platform</li><li>Practical playbooks, templates and examples</li><li>Free Community and weekly Power Hours</li><li>Connected tools ready for your next move</li></ul></div><aside class="p-offer-box"><div class="pp-name">Renegade CRM</div><div class="pp-price"><strong>$99</strong><span>/ month</span></div><p class="pp-desc" style="margin-bottom:22px">The tools. The playbooks. A clear place to start.</p><a class="p-btn p-btn-primary p-btn-block" href={links.crmMonthly} rel="noopener">Start for $99/mo</a><span class="pp-alt">Or <a href={links.crmAnnual} rel="noopener">pay $1,149 for the year</a>.</span></aside></div>
      </section>
      <section class="p-sec"><div class="p-narrow"><span class="p-eyebrow">Straight answers</span><h2 class="p-h2">Questions about Renegade CRM</h2><Faq items={faqs} /></div></section>
      <section class="p-sec p-sec-dark"><div class="p-narrow p-center"><h2 class="p-h2">Your next opportunity has a place to grow.</h2><p class="p-lead">Start with one useful system. Build your capability. Grow on purpose.</p><div class="p-btns"><a class="p-btn p-btn-primary" href={links.crmMonthly} rel="noopener">Start Renegade CRM — $99/mo</a></div></div></section>
    </main>
    <Footer />
  </div>
</BaseLayout>
<style>
  #amplify .p-body p{color:#c9c9c9}
  .crm-tools{margin-top:20px}
  .crm-amplifier{align-self:center;min-width:0}
  .crm-stage{position:relative;aspect-ratio:16/9;display:flex;align-items:center;justify-content:center;overflow:hidden;border:1px solid var(--p-gold);border-radius:12px;background:#111}
  .crm-stage img{position:absolute;width:60%;height:auto;opacity:.16;transform:rotate(-12deg)}
  .crm-stage p{position:relative;padding:24px;text-align:center;color:#fff;font-size:clamp(20px,3vw,32px);line-height:1.4}
  .crm-stage strong{color:var(--p-gold)}
  .crm-video{display:block;width:100%;aspect-ratio:16/9;border-radius:12px;background:#111}
</style>
