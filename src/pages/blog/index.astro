---
import { getCollection } from 'astro:content';
import { isLive } from '../../lib/live.js';
import { fmtDate, readTime } from '../../lib/media.js';
import { links } from '../../lib/links.js';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Cover from '../../components/Cover.astro';
import Banner from '../../components/Banner.astro';
import { brand } from '../../lib/site.js';

const posts = (await getCollection('blog'))
  .filter(isLive)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featured = posts.find((p) => p.data.featured) ?? posts[0];
const rest = posts.filter((p) => p.id !== featured?.id);
const seriesList = [...new Set(rest.map((p) => p.data.series).filter(Boolean))];

const latestEpisode = (await getCollection('podcast'))
  .filter((e) => !e.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())[0];
---

<BaseLayout
  title="The Renegade Blog | Marketing Renegades"
  description="Practical marketing systems, playbooks, field notes and experiments for entrepreneurs, from Darin Rhodes and Marketing Renegades."
>
  <div class="page">
    <Header />
    <Banner src={brand.banners.blog} alt="The Renegade Blog" />
    <main>
      <section class="p-hero">
        <div class="p-wrap">
          <span class="p-eyebrow">The Renegade Blog</span>
          <h1 class="p-h1">Useful marketing ideas. <span class="p-hl">Built in public.</span></h1>
          <p class="p-lead">Playbooks you can steal, field notes from what we're actually testing, and the occasional deep dive. No giant course required. Take the idea and use it.</p>
        </div>
      </section>

      <section class="p-sec" style="padding-top:64px">
        <div class="p-wrap">
          {featured && (
            <a class="pm-feature" href={`/blog/${featured.id}/`}>
              <Cover large title={featured.data.title} kicker={featured.data.visualKicker} series={featured.data.series} image={featured.data.image} imageAlt={featured.data.imageAlt} tone={featured.data.visualTone} />
              <div class="pm-feature-copy">
                <div class="pm-meta"><b>Start here</b><span>{fmtDate(featured.data.pubDate)}</span><span>{readTime(featured.body)}</span></div>
                <h2>{featured.data.title}</h2>
                <p>{featured.data.description}</p>
                <span class="pm-go">Read the article →</span>
              </div>
            </a>
          )}

          {seriesList.length > 1 && (
            <div class="pm-filters" role="group" aria-label="Filter articles">
              <button type="button" data-filter="all" aria-pressed="true">All articles</button>
              {seriesList.map((s) => <button type="button" data-filter={s} aria-pressed="false">{s}</button>)}
            </div>
          )}

          <div class="pm-grid" style={seriesList.length > 1 ? '' : 'margin-top:56px'}>
            {rest.map((post) => (
              <a class="pm-card" href={`/blog/${post.id}/`} data-series={post.data.series ?? ''}>
                <Cover title={post.data.title} kicker={post.data.visualKicker} series={post.data.series} image={post.data.image} imageAlt={post.data.imageAlt} tone={post.data.visualTone} />
                <div class="pm-meta"><b>{post.data.category}</b><span>{readTime(post.body)}</span></div>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
              </a>
            ))}
          </div>
        </div>
      </section>

      {latestEpisode && (
        <section class="p-sec p-sec-alt">
          <div class="p-wrap">
            <div class="p-head">
              <span class="p-eyebrow">Rather listen?</span>
              <h2 class="p-h2">The No Fear Marketing Show</h2>
            </div>
            <div class="pod-player" style="margin-top:32px">
              {latestEpisode.data.image && <img src={latestEpisode.data.image} alt="" loading="lazy" />}
              <div>
                <div class="pm-meta"><b>Latest episode</b>{latestEpisode.data.duration && <span>{latestEpisode.data.duration}</span>}</div>
                <h3>{latestEpisode.data.title}</h3>
                <p>{latestEpisode.data.description}</p>
                <audio class="p-audio" controls preload="none" src={latestEpisode.data.audioUrl}></audio>
                <p style="margin-top:12px"><a class="p-link" href="/podcast">All episodes →</a></p>
              </div>
            </div>
          </div>
        </section>
      )}

      <section class="p-sec p-sec-dark">
        <div class="p-narrow p-center">
          <span class="p-eyebrow">Turn the idea into a system</span>
          <h2 class="p-h2">Reading about it is step one. Running it is the point.</h2>
          <p class="p-lead">Renegade CRM gives you the software and the playbooks to put these ideas to work, for $99 a month. Or join the free community and steal more ideas first.</p>
          <div class="p-btns">
            <a class="p-btn p-btn-primary" href="/crm">See Renegade CRM</a>
            <a class="p-btn p-btn-secondary" style="background:transparent;color:#fff;border-color:rgba(255,255,255,.45)" href={links.community}>Join the community free</a>
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </div>
</BaseLayout>

<script is:inline>
  document.querySelectorAll('.pm-filters button').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var f = btn.getAttribute('data-filter');
      document.querySelectorAll('.pm-filters button').forEach(function (b) { b.setAttribute('aria-pressed', b === btn ? 'true' : 'false'); });
      document.querySelectorAll('.pm-card[data-series]').forEach(function (c) {
        c.hidden = !(f === 'all' || c.getAttribute('data-series') === f);
      });
    });
  });
</script>
