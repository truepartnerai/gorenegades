---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import EditorialCover from '../../components/EditorialCover.astro';
import '../../styles/content.css';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((post) => !post.data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const podcastEpisodes = post.data.relatedPodcast ? await getCollection('podcast') : [];
const relatedPodcast = post.data.relatedPodcast
  ? podcastEpisodes.find((episode) => episode.id === post.data.relatedPodcast && !episode.data.draft)
  : undefined;
const generatedSocialImage = new URL(`/og/${post.id}.png`, Astro.site ?? Astro.url.origin).href;
const ogImage = post.data.socialImage
  ? new URL(post.data.socialImage, Astro.site ?? Astro.url.origin).href
  : generatedSocialImage;
---

<BaseLayout
  title={`${post.data.title} | Marketing Renegades`}
  description={post.data.description}
  ogType="article"
  ogImage={ogImage}
>
  <div class="page content-shell">
    <Header />
    <main>
      <header class="article-header article-header-editorial">
        <div class="wrap article-header-grid">
          <div class="article-header-copy">
            <a class="article-back" href="/blog">← Renegade Media</a>
            <div class="content-meta">{post.data.series ? `${post.data.series} · ` : ''}{post.data.category} · {post.data.pubDate.toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'})}</div>
            <h1>{post.data.title}</h1>
            <p class="article-deck">{post.data.description}</p>
            <div class="article-byline">
              <span>By {post.data.author}</span>
              {post.data.updatedDate && <span>Updated {post.data.updatedDate.toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'})}</span>}
            </div>
            {post.data.tags.length > 0 && (
              <div class="tag-row">
                {post.data.tags.map((tag) => <span>{tag}</span>)}
              </div>
            )}
          </div>
          <EditorialCover
            title={post.data.title}
            series={post.data.series}
            category={post.data.category}
            image={post.data.image}
            imageAlt={post.data.imageAlt}
            visualKicker={post.data.visualKicker}
            tone={post.data.visualTone}
          />
        </div>
      </header>

      <article class="article-body">
        <div class="article-wrap">
          <Content />
          {relatedPodcast && (
            <aside class="article-podcast-callout">
              <div class="content-meta">Related No Fear Marketing Show</div>
              <h2>{relatedPodcast.data.title}</h2>
              <p>{relatedPodcast.data.description}</p>
              <a class="read-more" href={`/podcast/${relatedPodcast.id}/`}>Listen to the episode →</a>
            </aside>
          )}
          <aside class="article-endcap">
            <div class="content-meta">Keep going</div>
            <h2>Turn the idea into a system.</h2>
            <p>Renegade CRM gives independent business owners one place to organize follow-up, database marketing, email, text, reviews, automation, and the other pieces that are easy to forget when business gets busy.</p>
            <div class="episode-links">
              <a class="btn btn-gold" href="/crm">See Renegade CRM →</a>
              <a class="text-link" href="https://community.gorenegades.com">Join the free community →</a>
            </div>
          </aside>
        </div>
      </article>
    </main>
    <Footer />
  </div>
</BaseLayout>
