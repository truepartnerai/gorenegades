---
import { getCollection, render } from 'astro:content';
import { isLive } from '../../lib/live.js';
import { fmtDate, readTime } from '../../lib/media.js';
import { links } from '../../lib/links.js';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Cover from '../../components/Cover.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('blog'))
    .filter(isLive)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post, related: posts.filter((p) => p.id !== post.id).slice(0, 3) }
  }));
}

const { post, related } = Astro.props;
const { Content } = await render(post);
const relatedPodcast = post.data.relatedPodcast
  ? (await getCollection('podcast')).find((e) => e.id === post.data.relatedPodcast && !e.data.draft)
  : undefined;
const generatedSocialImage = new URL(`/og/${post.id}.png`, Astro.site ?? Astro.url.origin).href;
const ogImage = post.data.socialImage
  ? new URL(post.data.socialImage, Astro.site ?? Astro.url.origin).href
  : generatedSocialImage;
---

<BaseLayout
  title={`${post.data.title} | Marketing Renegades`}
  description={post.data.description}
  ogType="article"
  ogImage={ogImage}
>
  <div class="page">
    <Header />
    <main>
      <header class="p-hero">
        <div class="p-wrap pa-head">
          <a class="pa-back" href="/blog">← All articles</a>
          <div><span class="p-eyebrow">{post.data.series ?? post.data.category}</span></div>
          <h1 class="p-h1">{post.data.title}</h1>
          <p class="p-lead">{post.data.description}</p>
          <div class="pa-byline">
            <span>By <strong>{post.data.author}</strong></span>
            <span>{fmtDate(post.data.pubDate, true)}</span>
            <span>{readTime(post.body)}</span>
            {post.data.updatedDate && <span>Updated {fmtDate(post.data.updatedDate)}</span>}
          </div>
          {post.data.tags.length > 0 && <div class="pa-tags">{post.data.tags.map((t) => <span>{t}</span>)}</div>}
        </div>
      </header>

      <article class="p-prose">
        <Content />
      </article>

      <div class="pa-end">
        {relatedPodcast && (
          <div class="pod-player" style="margin-bottom:24px">
            {relatedPodcast.data.image && <img src={relatedPodcast.data.image} alt="" loading="lazy" />}
            <div>
              <div class="pm-meta"><b>Related episode</b></div>
              <h3>{relatedPodcast.data.title}</h3>
              <audio class="p-audio" controls preload="none" src={relatedPodcast.data.audioUrl}></audio>
            </div>
          </div>
        )}
        <aside class="pa-cta">
          <span class="p-eyebrow" style="color:var(--p-gold)">Turn the idea into a system</span>
          <h2 style="margin-top:8px">Want this running in your business without remembering to do it?</h2>
          <p>Renegade CRM gives you the software plus the playbooks to set it up, for $99 a month.</p>
          <div class="p-btns">
            <a class="p-btn p-btn-primary" href="/crm">See Renegade CRM</a>
            <a class="p-btn p-btn-secondary" href={links.community}>Join the community free</a>
          </div>
        </aside>
      </div>

      {related.length > 0 && (
        <section class="p-sec">
          <div class="p-wrap">
            <div class="p-head">
              <span class="p-eyebrow">Keep reading</span>
              <h2 class="p-h2">More from the blog</h2>
            </div>
            <div class="pm-grid" style="margin-top:32px">
              {related.map((p) => (
                <a class="pm-card" href={`/blog/${p.id}/`}>
                  <Cover title={p.data.title} kicker={p.data.visualKicker} series={p.data.series} image={p.data.image} imageAlt={p.data.imageAlt} tone={p.data.visualTone} />
                  <div class="pm-meta"><b>{p.data.category}</b><span>{readTime(p.body)}</span></div>
                  <h3>{p.data.title}</h3>
                </a>
              ))}
            </div>
          </div>
        </section>
      )}
    </main>
    <Footer />
  </div>
</BaseLayout>
