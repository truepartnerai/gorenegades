---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const outcomes=[
['Build a weekly marketing rhythm','Decide what happens every week so marketing stops depending on memory or spare time.'],
['Work your database consistently','Build email, nurture, reviews, referrals and repeat-business systems.'],
['Create new opportunities','Launch lead-generation campaigns and the follow-up that turns inquiries into conversations.'],
['Use content with leverage','Turn useful ideas into repeatable content instead of rebuilding your marketing every day.'],
['Build referral relationships','Create a real rhythm around partners, events, communication and staying useful.'],
['Use the software for something real','Build workflows, campaigns, pipelines and automations inside Renegade CRM as we go.']
];
const weeks=[
['01','Foundation','Choose the few marketing systems that matter most and organize the machine.'],
['02','Content + visibility','Turn useful ideas into a repeatable visibility system.'],
['03','Email + database','Build consistent communication with the people who already know you.'],
['04','Lead generation','Create campaigns that bring new people into your world.'],
['05','Build lab','Work directly on what is stuck, unfinished or underperforming.'],
['06','Events + relationships','Use webinars, events and partnerships to create more opportunity.'],
['07','Reviews + referrals','Build the ask and follow-up into the customer journey.'],
['08','Make it repeatable','Tie the pieces together into a marketing system you can keep running.']
];
---
<BaseLayout title="Renegade Academy | Build Your Marketing System With Us" description="Renegade Academy is an 8-week live implementation program for entrepreneurs who want to build practical marketing systems with help.">
<div class="page academy-v4">
<Header ctaLabel="Join the Academy" ctaHref="#enroll" />
<main>
<section class="hero"><div class="wrap heroGrid">
<div>
<span class="kicker">Renegade Academy</span>
<h1>Stop collecting marketing ideas. <span>Build the system.</span></h1>
<p class="core">An 8-week live implementation program for entrepreneurs who want marketing running in the business — not sitting in a notebook.</p>
<p class="sub">We teach the strategy, open the software, build the campaigns and workflows, troubleshoot what gets stuck, and keep moving.</p>
<div class="ctas"><a class="primary" href="#enroll">Join the next Academy →</a><a class="secondary" href="#how">See how it works</a></div>
<div class="trust"><span>8 weeks live</span><span>Renegade CRM included</span><span>Implementation focused</span></div>
</div>
<aside class="buildPanel">
<span class="panelLabel">What happens here</span>
<div><b>Learn it</b><p>Understand the strategy.</p></div>
<div><b>Build it</b><p>Put it into your actual business.</p></div>
<div><b>Use it</b><p>Leave with marketing running.</p></div>
</aside>
</div></section>

<section class="section"><div class="wrap">
<div class="head"><span class="kicker">What you build</span><h2>A marketing system that lives in your real business.</h2><p>Not more theory. A working rhythm around the marketing activities that create opportunity.</p></div>
<div class="cards">{outcomes.map(([t,d],i)=><article><span>{String(i+1).padStart(2,'0')}</span><h3>{t}</h3><p>{d}</p></article>)}</div>
</div></section>

<section class="gold" id="how"><div class="wrap goldGrid">
<div><span class="kicker dark">The Academy model</span><h2>Learn it. Build it. Use it.</h2><p>Every class is designed to move from understanding to implementation. The goal is not more notes. The goal is marketing running.</p></div>
<div class="weekList">{weeks.map(([n,t,d])=><div><span>{n}</span><section><b>{t}</b><p>{d}</p></section></div>)}</div>
</div></section>

<section class="section"><div class="wrap split">
<div><span class="kicker">Who this is for</span><h2>You already know many of the things you should be doing.</h2><p>Follow up faster. Email the database. Ask for reviews. Create content. Generate leads. Stay in touch with referral partners.</p><p>The hard part is turning those ideas into a system that keeps moving while you run the business.</p></div>
<div class="quote"><span>THE POINT</span><blockquote>Build capability, not dependency.</blockquote><p>Use the tools, understand the strategy, and leave with a system you can continue improving.</p></div>
</div></section>

<section class="offer" id="enroll"><div class="wrap offerGrid">
<div><span class="kicker dark">Renegade Academy</span><h2>Eight weeks to build the machine.</h2><p>Live implementation, Renegade CRM for your first year, playbooks, community and support.</p></div>
<aside class="offerCard"><span>ACADEMY TUITION</span><div class="price">$2,500</div><p>Includes the 8-week live cohort and your first year of Renegade CRM.</p><a href="https://enroll.gorenegades.com">Enroll in Renegade Academy →</a></aside>
</div></section>

<section class="final"><div class="wrap finalGrid"><div><span class="kicker">Ready to build?</span><h2>Make marketing easier to run.</h2></div><div><p>Bring the business you already have. We will help you turn the right marketing ideas into repeatable systems.</p><a class="primary" href="https://enroll.gorenegades.com">Join Renegade Academy →</a></div></div></section>
</main><Footer /></div></BaseLayout>
<style>
.academy-v4{background:#090909;color:#f7f7f5}.kicker{display:inline-flex;align-items:center;gap:9px;font:700 11px/1 var(--mono);letter-spacing:.14em;text-transform:uppercase;color:var(--gold)}.kicker:before{content:'';width:24px;height:2px;background:var(--gold)}
.hero{padding:88px 0;background:radial-gradient(circle at 78% 28%,rgba(244,194,13,.12),transparent 30%),#090909}.heroGrid{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(360px,.65fr);gap:80px;align-items:center}
.hero h1,.head h2,.gold h2,.split h2,.offer h2,.final h2{font-family:var(--body);font-weight:700;letter-spacing:-.05em;line-height:.98}.hero h1{font-size:clamp(54px,6.7vw,92px);margin-top:22px}.hero h1 span{color:var(--gold)}
.core{font-size:clamp(21px,2vw,27px);line-height:1.4;font-weight:600;max-width:760px;margin-top:30px}.sub{font-size:17px;line-height:1.7;color:#999;max-width:720px;margin-top:18px}
.ctas{display:flex;flex-wrap:wrap;gap:12px;margin-top:32px}.primary,.secondary{display:inline-flex;align-items:center;justify-content:center;min-height:52px;padding:0 22px;border-radius:8px;font-size:15px;font-weight:700}.primary{background:var(--gold);color:#0a0a0a}.secondary{background:#111;color:#fff;border:1px solid #333}.secondary:hover{border-color:var(--gold);color:var(--gold)}
.trust{display:flex;flex-wrap:wrap;gap:10px 22px;color:#777;font-size:12px;margin-top:25px}.trust span:before{content:'•';color:var(--gold);margin-right:8px}
.buildPanel{background:#101010;border:1px solid #292929;border-radius:16px;padding:28px;box-shadow:0 30px 80px rgba(0,0,0,.45)}.panelLabel{font:700 9px/1 var(--mono);letter-spacing:.14em;color:var(--gold)}.buildPanel>div{padding:20px 0;border-bottom:1px solid #252525}.buildPanel>div:last-child{border-bottom:0}.buildPanel b{font-size:22px}.buildPanel p{color:#888;font-size:13px;margin-top:4px}
.section,.final{padding:104px 0}.head{max-width:860px}.head h2,.split h2,.final h2{font-size:clamp(40px,5vw,68px);margin-top:18px}.head p,.split p,.final p{font-size:18px;line-height:1.7;color:#999;max-width:720px;margin-top:22px}
.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:48px}.cards article{background:#101010;border:1px solid #222;border-radius:12px;padding:26px}.cards article>span{font:700 10px/1 var(--mono);color:var(--gold)}.cards h3{font-size:22px;margin-top:28px}.cards p{font-size:14px;line-height:1.65;color:#888;margin-top:10px}
.gold,.offer{padding:104px 0;background:var(--gold);color:#0a0a0a}.goldGrid,.split,.offerGrid,.finalGrid{display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:start}.dark{color:#0a0a0a}.dark:before{background:#0a0a0a}.gold h2,.offer h2{font-size:clamp(42px,5vw,68px);margin-top:18px}.gold p,.offer p{font-size:17px;line-height:1.65;color:#332a08;margin-top:20px}
.weekList{border-top:1px solid rgba(0,0,0,.3)}.weekList>div{display:grid;grid-template-columns:52px 1fr;gap:18px;padding:17px 0;border-bottom:1px solid rgba(0,0,0,.25)}.weekList>div>span{font:700 10px/1 var(--mono);padding-top:4px}.weekList b{font-size:16px}.weekList p{font-size:13px;line-height:1.5;margin-top:4px}
.quote{border-left:3px solid var(--gold);padding-left:28px}.quote>span{font:700 10px/1 var(--mono);color:var(--gold)}.quote blockquote{font-size:clamp(34px,4vw,54px);line-height:1.05;letter-spacing:-.04em;font-weight:700;margin-top:20px}.quote p{font-size:15px}
.offerCard{background:#0a0a0a;color:#fff;border-radius:16px;padding:32px}.offerCard>span{font:700 10px/1 var(--mono);letter-spacing:.14em;color:var(--gold)}.price{font-size:72px;font-weight:700;letter-spacing:-.06em;line-height:.95;margin:20px 0}.offerCard p{color:#aaa}.offerCard a{display:block;background:var(--gold);color:#0a0a0a;text-align:center;padding:15px;border-radius:8px;font-weight:700;margin-top:24px}
.final{background:#0d0d0d}.final .primary{margin-top:26px}
@media(max-width:980px){.heroGrid,.goldGrid,.split,.offerGrid,.finalGrid{grid-template-columns:1fr}.cards{grid-template-columns:1fr 1fr}}@media(max-width:640px){.hero,.section,.gold,.offer,.final{padding:72px 0}.hero h1{font-size:clamp(44px,13vw,62px)}.cards{grid-template-columns:1fr}.primary,.secondary{width:100%}}
</style>