---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Faq from '../../components/Faq.astro';
import { links } from '../../lib/links.js';
import { brand } from '../../lib/site.js';

// Ways to make money with Renegade CRM. [title, what it does, first step]
const ways = [
  ['Email your database', 'The people who already know you are your fastest money. Send a useful email every month and stay the first name they think of.', 'Import your contacts and send your first email.'],
  ['Post automatically', 'Write once, schedule a week of posts to your social accounts, and get back to running your business.', 'Connect your accounts and schedule your first week.'],
  ['Collect more reviews', 'Ask every happy customer for a review right after the job, automatically, so it happens every time.', 'Turn on an automatic review request.'],
  ['Never miss a lead', 'Missed a call? A text goes out instantly so the lead talks to you instead of the next company on the list.', 'Turn on missed-call text back.'],
  ['Let AI follow up', 'An AI assistant answers new inquiries by text or chat and helps get them on your calendar.', 'Set up your AI assistant with your business details.'],
  ['Book appointments', 'Share one booking link. People pick a time, and reminders go out on their own so fewer people no-show.', 'Create your calendar and booking link.'],
  ['Run ads', 'Launch ads from the same place your leads land, so every new lead goes straight into your follow-up.', 'Connect your ad account and launch one campaign.'],
  ['Build a landing page', 'Put up a simple page for an offer, event or freebie without hiring a web designer.', 'Pick a template and publish it.']
];

const replaces = ['Email marketing', 'Text messaging', 'Social scheduling', 'Review requests', 'Online booking', 'Landing pages & websites', 'Contact manager', 'Follow-up automation'];

const roadmap = [
  'Get your people in one place',
  'Email your database',
  'Never miss a lead',
  'Make booking easy',
  'Collect reviews automatically',
  'Post without thinking about it',
  'Let AI handle the first reply',
  'Turn on ads'
];

const faqs: [string, string][] = [
  ['What is Renegade CRM?', 'All-in-one marketing software for small businesses. Your contacts, email, text, social posting, reviews, booking, landing pages, ads and AI follow-up live in one place, with step-by-step playbooks that show you how to use them.'],
  ['Do I need to use everything?', 'No, and you should not try. Pick the one thing that would help your business most right now, get it working, then add the next.'],
  ['I am not technical. Can I do this?', 'Yes. The 2027 Marketing Roadmap tells you what to turn on first, and each playbook walks you through it in plain English. Bring questions to the free weekly Power Hour.'],
  ['Is there a contract?', 'No. The monthly plan is $99 and you can cancel before your next billing date. There is also an annual option for $1,149.'],
  ['Are there costs beyond $99 a month?', 'Texting, calling, AI and email sending are billed based on how much you use them, so you only pay for what you actually send. Optional done-for-you setup is priced separately.'],
  ['Why not buy GoHighLevel directly?', 'Renegade CRM runs on the HighLevel platform. With us you also get the Renegade playbooks, templates, the 2027 Marketing Roadmap, the Community and weekly Power Hours, so you are not figuring it out alone.']
];
---

<BaseLayout
  title="Renegade CRM | All-in-One Marketing Software — $99/mo"
  description="All-in-one marketing software for small businesses: email, text, social posting, reviews, booking, landing pages, ads and AI follow-up in one place. $99/month, no contract."
>
  <div class="lp">
    <header class="lp-top">
      <div class="p-wrap lp-top-in">
        <div class="lp-brand">
          <img src={brand.insignia} alt="" width="44" height="44" />
          <span>Marketing <strong>Renegades</strong></span>
        </div>
        <a class="lp-top-cta" href="#checkout" data-checkout-trigger>Start for $99/mo</a>
      </div>
    </header>

    <main>
      <!-- HERO: what it is, who it's for, one button -->
      <section class="lp-hero">
        <div class="p-wrap lp-hero-in">
          <span class="p-eyebrow">Renegade CRM · For small businesses and entrepreneurs</span>
          <h1>All-in-one marketing software to <span>power your business.</span></h1>
          <p class="lp-lead">Email your list, post to social, collect reviews, book appointments and follow up with every lead, all from one place. Start with the one thing you need most. We'll show you exactly how to turn it on.</p>
          <div class="lp-buy">
            <a class="p-btn p-btn-primary lp-main-cta" href="#checkout" data-checkout-trigger>Start Renegade CRM — $99/mo</a>
            <div class="lp-assure">
              <span>No contract</span>
              <span>Cancel anytime</span>
              <span>Free 2027 Marketing Roadmap</span>
            </div>
          </div>
        </div>
      </section>

      <!-- THREE REASONS -->
      <section class="lp-reasons">
        <div class="p-wrap lp-reasons-in">
          <article>
            <h2>Easy to use</h2>
            <p>Step-by-step playbooks walk you through each tool in plain English. No tech degree required.</p>
          </article>
          <article>
            <h2>Affordable</h2>
            <p>One low monthly price for tools most businesses pay for one app at a time.</p>
          </article>
          <article>
            <h2>Packed with features</h2>
            <p>Start with the one or two you need today. The rest are waiting when you're ready to grow.</p>
          </article>
        </div>
      </section>

      <!-- WAYS TO MAKE MONEY -->
      <section class="lp-sec" id="ways">
        <div class="p-wrap">
          <div class="lp-head">
            <span class="p-eyebrow">What do you need first?</span>
            <h2>Pick one way to make money with it.</h2>
            <p>You don't need all of these. Pick the one that would help your business most this month, and start there.</p>
          </div>
          <div class="lp-ways">
            {ways.map(([title, text, step], i) => (
              <article class="lp-way">
                <span class="lp-num">{String(i + 1).padStart(2, '0')}</span>
                <h3>{title}</h3>
                <p>{text}</p>
                <div class="lp-step"><strong>First step:</strong> {step}</div>
              </article>
            ))}
          </div>
          <p class="lp-ways-note">AI, texting and calling are billed as you use them. Everything else is included.</p>
        </div>
      </section>

      <!-- REPLACES THE PILE OF APPS -->
      <section class="lp-sec lp-alt">
        <div class="p-wrap lp-replace">
          <div>
            <span class="p-eyebrow">One login instead of a pile of apps</span>
            <h2>All the things you need, in one low price.</h2>
            <p class="lp-copy">Most small businesses end up paying for a separate tool for every job, and none of them talk to each other. Renegade CRM puts every one of these in the same place, so a new lead, a booked appointment and a five-star review all land in one spot.</p>
          </div>
          <div class="lp-replace-card">
            <ul>
              {replaces.map((r) => <li>{r}</li>)}
            </ul>
            <div class="lp-replace-total">
              <span>All of it, one login</span>
              <strong>$99<small>/mo</small></strong>
            </div>
          </div>
        </div>
      </section>

      <!-- WHERE TO START: the bonus -->
      <section class="lp-sec lp-dark">
        <div class="p-wrap lp-road">
          <div>
            <span class="lp-badge">Free bonus with your subscription</span>
            <h2>Not sure where to start? We already mapped it out.</h2>
            <p class="lp-copy">The <strong>2027 Marketing Roadmap</strong> shows you what to turn on in Renegade CRM, and in what order, so every step pays for itself before you add the next one. Each step comes with a playbook that walks you through the setup.</p>
            <p class="lp-copy">Stuck anyway? Bring your question to the free weekly Power Hour and the Renegade Community. You won't be figuring this out alone.</p>
          </div>
          <ol class="lp-road-list">
            {roadmap.map((step) => <li>{step}</li>)}
          </ol>
        </div>
      </section>

      <!-- OFFER + CHECKOUT -->
      <section class="lp-sec lp-offer-sec" id="checkout">
        <div class="p-wrap">
          <div class="lp-head lp-head-center">
            <span class="p-eyebrow">Start today</span>
            <h2>Renegade CRM. $99 a month.</h2>
            <p>Everything below is included. No contract, cancel anytime.</p>
          </div>

          <div class="lp-offer">
            <div class="lp-offer-card">
              <div class="lp-offer-price"><strong>$99</strong><span>/month</span></div>
              <p class="lp-offer-annual">Or pay $1,149 for the year.</p>
              <ul>
                <li>Contacts, pipelines and the mobile app</li>
                <li>Email and two-way text</li>
                <li>Social media scheduling</li>
                <li>Review requests</li>
                <li>Calendars, booking and reminders</li>
                <li>Landing pages, forms and websites</li>
                <li>Ads, AI assistants and automations</li>
                <li>Renegade playbooks and templates</li>
                <li>Free Community and weekly Power Hours</li>
                <li class="lp-bonus">Bonus: the 2027 Marketing Roadmap</li>
              </ul>
              <p class="lp-offer-fine">Texting, calling, AI and email sending are billed as used. Optional done-for-you setup is priced separately.</p>
            </div>

            <div class="lp-checkout-shell">
              <iframe
                id="renegade-checkout-frame"
                title="Renegade CRM secure checkout"
                data-base-src={links.crmMonthly}
                src={links.crmMonthly + '#two-setp-order-4jiP-au3mA'}
                loading="lazy"
                allow="payment"
                referrerpolicy="strict-origin-when-cross-origin"
              ></iframe>
            </div>
          </div>
          <p class="lp-checkout-note">Prefer a full page? <a id="lp-checkout-external" href={links.crmMonthly} rel="noopener">Open the secure order form.</a></p>
        </div>
      </section>

      <!-- FAQ -->
      <section class="lp-sec lp-alt">
        <div class="p-narrow">
          <span class="p-eyebrow">Quick answers</span>
          <h2 class="lp-faq-title">Questions before you start</h2>
          <Faq items={faqs} />
        </div>
      </section>

      <!-- FINAL CTA -->
      <section class="lp-final">
        <div class="p-narrow">
          <img src={brand.insignia} alt="" width="64" height="64" />
          <h2>Pick one thing. Turn it on this week.</h2>
          <p>Every tool your business needs to market itself, a roadmap for what to do first, and people to help when you get stuck. All for $99 a month.</p>
          <a class="p-btn p-btn-primary lp-main-cta" href="#checkout" data-checkout-trigger>Start Renegade CRM — $99/mo</a>
        </div>
      </section>
    </main>

    <footer class="lp-footer">
      <div class="p-wrap">
        <strong>Marketing Renegades</strong>
        <span>Results depend on your effort and circumstances; no specific outcome is guaranteed.</span>
      </div>
    </footer>

    <div class="lp-mobile-cta">
      <a href="#checkout" data-checkout-trigger>Start Renegade CRM — $99/mo</a>
    </div>
  </div>

  <script is:inline>
    (() => {
      // Carry ad attribution into the HighLevel checkout.
      const params = new URLSearchParams(window.location.search);
      const keep = ['utm_source','utm_medium','utm_campaign','utm_content','utm_term','fbclid','gclid'];
      const carry = new URLSearchParams();
      keep.forEach((key) => {
        const value = params.get(key);
        if (value) carry.set(key, value);
      });

      const frame = document.getElementById('renegade-checkout-frame');
      if (frame && frame.dataset.baseSrc) {
        try {
          const url = new URL(frame.dataset.baseSrc);
          carry.forEach((value, key) => url.searchParams.set(key, value));
          url.hash = 'two-setp-order-4jiP-au3mA';
          frame.src = url.toString();
        } catch (_) {}
      }

      // A CTA click only scrolls to checkout; it is not a checkout start or
      // purchase. Those events belong to the HighLevel order system and its
      // Meta Pixel/CAPI integration.
      // Funnel events for Meta. ViewContent = saw the offer page.
      // InitiateCheckout = scrolled the order form into view (the form itself
      // lives on HighLevel's domain, so this is the closest signal this page has).
      if (typeof window.fbq === 'function') {
        window.fbq('track', 'ViewContent', { content_name: 'Renegade CRM', value: 99, currency: 'USD' });
      }
      if (frame && 'IntersectionObserver' in window) {
        let sent = false;
        const io = new IntersectionObserver((entries) => {
          if (sent || !entries.some((e) => e.isIntersecting)) return;
          sent = true;
          io.disconnect();
          if (typeof window.fbq === 'function') {
            window.fbq('track', 'InitiateCheckout', { content_name: 'Renegade CRM', value: 99, currency: 'USD' });
          }
        }, { threshold: 0.25 });
        io.observe(frame);
      }

      const externalCheckout = document.getElementById('lp-checkout-external');
      if (externalCheckout) {
        const externalUrl = new URL(externalCheckout.href);
        carry.forEach((value, key) => externalUrl.searchParams.set(key, value));
        externalCheckout.href = externalUrl.toString();
      }
    })();
  </script>

  <style>
    .lp{background:#fff;color:#1f1f1f}
    .lp h1,.lp h2,.lp h3{text-wrap:balance}

    .lp-top{background:#0b0b0b;border-bottom:1px solid rgba(255,255,255,.09);position:sticky;top:0;z-index:60}
    .lp-top-in{height:64px;display:flex;align-items:center;justify-content:space-between;gap:24px}
    .lp-brand{display:flex;align-items:center;gap:10px;color:#fff;font-size:18px;font-weight:800;letter-spacing:-.02em}
    .lp-brand img{width:34px;height:34px;object-fit:contain}
    .lp-brand strong{color:var(--p-gold)}
    .lp-top-cta{background:var(--p-gold);color:#111;font-weight:800;font-size:14px;padding:10px 16px;border-radius:8px;white-space:nowrap}
    .lp-top-cta:hover{background:var(--p-gold-hover)}

    .lp-hero{position:relative;overflow:hidden;background:#0b0b0b;color:#fff;padding:92px 0 84px;text-align:center}
    .lp-hero::before{content:'';position:absolute;inset:0;background:radial-gradient(60% 55% at 50% 10%,rgba(244,194,13,.16),transparent 70%),linear-gradient(rgba(255,255,255,.026) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.026) 1px,transparent 1px);background-size:auto,60px 60px,60px 60px;pointer-events:none}
    .lp-hero-in{position:relative;z-index:1;max-width:980px}
    .lp-hero .p-eyebrow{color:var(--p-gold)}
    .lp-hero h1{margin:16px auto 0;font-size:clamp(40px,6.6vw,76px);line-height:1.02;letter-spacing:-.045em;font-weight:850;color:#fff}
    .lp-hero h1 span{color:var(--p-gold)}
    .lp-lead{max-width:760px;margin:24px auto 0;font-size:clamp(18px,2.1vw,21px);line-height:1.6;color:#cfcfcf}
    .lp-buy{margin-top:34px}
    .lp-main-cta{min-width:min(100%,360px);font-size:18px;padding:18px 30px}
    .lp-assure{display:flex;justify-content:center;flex-wrap:wrap;gap:10px 26px;margin-top:20px;font-size:15px;color:#bdbdbd}
    .lp-assure span::before{content:'✓';color:var(--p-gold);font-weight:800;margin-right:7px}

    .lp-reasons{background:var(--p-gold);color:#111}
    .lp-reasons-in{display:grid;grid-template-columns:repeat(3,1fr);gap:0}
    .lp-reasons article{padding:34px 30px}
    .lp-reasons article+article{border-left:1px solid rgba(0,0,0,.14)}
    .lp-reasons h2{font-size:22px;font-weight:850;letter-spacing:-.02em}
    .lp-reasons p{font-size:16px;line-height:1.55;margin-top:6px;color:#2a2200}

    .lp-sec{padding:96px 0;scroll-margin-top:64px}
    .lp-alt{background:var(--p-paper);border-top:1px solid var(--p-line);border-bottom:1px solid var(--p-line)}
    .lp-head{max-width:760px}
    .lp-head-center{text-align:center;margin:0 auto}
    .lp-head h2,.lp-replace h2,.lp-road h2,.lp-faq-title{font-size:clamp(32px,4.6vw,52px);line-height:1.06;letter-spacing:-.04em;color:var(--p-ink);margin:10px 0 0;font-weight:830}
    .lp-head>p{font-size:19px;color:var(--p-muted);margin-top:16px;line-height:1.6}
    .lp-copy{font-size:18px;line-height:1.7;color:var(--p-muted);margin-top:20px}

    .lp-ways{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:44px}
    .lp-way{display:flex;flex-direction:column;border:1px solid var(--p-line);border-radius:16px;padding:24px;background:#fff;transition:border-color .15s ease,transform .15s ease}
    .lp-way:hover{border-color:var(--p-gold);transform:translateY(-2px)}
    .lp-num{font-size:13px;font-weight:800;color:var(--p-gold-ink);letter-spacing:.06em}
    .lp-way h3{font-size:20px;line-height:1.2;letter-spacing:-.02em;color:#111;margin-top:10px}
    .lp-way p{font-size:15px;line-height:1.6;color:var(--p-muted);margin-top:8px;flex:1}
    .lp-step{margin-top:16px;padding-top:14px;border-top:1px dashed var(--p-line);font-size:14px;line-height:1.5;color:#333}
    .lp-step strong{color:var(--p-gold-ink)}
    .lp-ways-note{margin-top:22px;font-size:14px;color:var(--p-soft)}

    .lp-replace{display:grid;grid-template-columns:1.1fr .9fr;gap:64px;align-items:center}
    .lp-replace-card{background:#fff;border:1px solid var(--p-line);border-radius:18px;padding:30px;box-shadow:0 24px 50px -34px rgba(0,0,0,.3)}
    .lp-replace-card ul{list-style:none;display:grid;grid-template-columns:1fr 1fr;gap:12px 18px}
    .lp-replace-card li{position:relative;padding-left:26px;font-size:15.5px;font-weight:600;color:#222}
    .lp-replace-card li::before{content:'✓';position:absolute;left:0;top:0;width:18px;height:18px;border-radius:50%;background:var(--p-gold);color:#111;font-size:11px;font-weight:900;display:flex;align-items:center;justify-content:center;margin-top:3px}
    .lp-replace-total{display:flex;justify-content:space-between;align-items:center;margin-top:24px;padding:18px 20px;background:#111;border-radius:12px;color:#fff;font-weight:700}
    .lp-replace-total strong{font-size:34px;color:var(--p-gold);letter-spacing:-.04em}
    .lp-replace-total small{font-size:15px;color:#bbb;margin-left:2px}

    .lp-dark{background:#0b0b0b;color:#fff;border-top:6px solid var(--p-gold)}
    .lp-road{display:grid;grid-template-columns:1.05fr .95fr;gap:64px;align-items:center}
    .lp-dark h2{color:#fff}
    .lp-dark .lp-copy{color:#c4c4c4}
    .lp-dark .lp-copy strong{color:#fff}
    .lp-badge{display:inline-block;background:var(--p-gold);color:#111;font-size:12px;font-weight:800;letter-spacing:.07em;text-transform:uppercase;padding:7px 12px;border-radius:999px}
    .lp-road-list{list-style:none;counter-reset:r;display:grid;gap:10px}
    .lp-road-list li{counter-increment:r;display:flex;align-items:center;gap:14px;padding:14px 18px;background:#151515;border:1px solid rgba(255,255,255,.1);border-radius:12px;font-weight:650;font-size:16px;color:#eee}
    .lp-road-list li::before{content:counter(r);flex:none;width:30px;height:30px;border-radius:50%;background:var(--p-gold);color:#111;font-size:14px;font-weight:850;display:flex;align-items:center;justify-content:center}

    .lp-offer{display:grid;grid-template-columns:.85fr 1.15fr;gap:28px;align-items:start;margin-top:44px}
    .lp-offer-card{background:#111;color:#fff;border-radius:18px;padding:32px;border-top:6px solid var(--p-gold);position:sticky;top:88px}
    .lp-offer-price{display:flex;align-items:baseline;gap:8px}
    .lp-offer-price strong{font-size:68px;line-height:.95;letter-spacing:-.06em}
    .lp-offer-price span{font-size:17px;color:#aaa;font-weight:600}
    .lp-offer-annual{margin-top:8px;font-size:15px;color:#bdbdbd}
    .lp-offer-card ul{list-style:none;display:grid;gap:11px;margin-top:24px}
    .lp-offer-card li{position:relative;padding-left:26px;font-size:15.5px;color:#ddd}
    .lp-offer-card li::before{content:'✓';position:absolute;left:0;color:var(--p-gold);font-weight:900}
    .lp-offer-card li.lp-bonus{color:var(--p-gold);font-weight:750}
    .lp-offer-card li.lp-bonus::before{content:'★'}
    .lp-offer-fine{margin-top:22px;padding-top:16px;border-top:1px solid rgba(255,255,255,.12);font-size:13px;line-height:1.55;color:#8f8f8f}
    .lp-checkout-shell{background:#f4f4f2;border-radius:18px;overflow:hidden;border:1px solid var(--p-line);box-shadow:0 28px 60px -38px rgba(0,0,0,.45)}
    .lp-checkout-shell iframe{display:block;width:100%;height:1180px;border:0;background:#f4f4f2}
    .lp-checkout-note{text-align:center;color:var(--p-soft);font-size:13px;margin-top:16px}
    .lp-checkout-note a{color:#333;text-decoration:underline;text-decoration-color:var(--p-gold);text-underline-offset:3px}

    .lp-faq-title{margin-bottom:24px}

    .lp-final{padding:96px 0;background:#111;color:#fff;text-align:center;border-top:6px solid var(--p-gold)}
    .lp-final img{display:block;margin:0 auto 18px;width:64px;height:64px;object-fit:contain}
    .lp-final h2{font-size:clamp(36px,5.2vw,60px);line-height:1.04;letter-spacing:-.045em;color:#fff}
    .lp-final p{font-size:19px;line-height:1.6;color:#bdbdbd;max-width:620px;margin:20px auto 30px}
    .lp-footer{background:#080808;color:#777;padding:26px 0}
    .lp-footer .p-wrap{display:flex;justify-content:space-between;gap:18px;font-size:13px}
    .lp-footer strong{color:#aaa}
    .lp-mobile-cta{display:none}

    @media(max-width:1000px){
      .lp-ways{grid-template-columns:repeat(2,1fr)}
    }
    @media(max-width:850px){
      .lp-replace,.lp-road,.lp-offer{grid-template-columns:1fr;gap:36px}
      .lp-offer-card{position:static}
      .lp-reasons-in{grid-template-columns:1fr}
      .lp-reasons article{padding:22px 4px}
      .lp-reasons article+article{border-left:0;border-top:1px solid rgba(0,0,0,.14)}
    }
    @media(max-width:640px){
      .lp-top-in{height:58px}
      .lp-brand{font-size:15px}
      .lp-brand img{width:28px;height:28px}
      .lp-top-cta{font-size:13px;padding:9px 12px}
      .lp-hero{padding:56px 0 64px}
      .lp-hero h1{font-size:clamp(36px,10.5vw,52px)}
      .lp-lead{font-size:17.5px}
      .lp-main-cta{width:100%}
      .lp-sec{padding:64px 0}
      .lp-ways{grid-template-columns:1fr;margin-top:32px}
      .lp-replace-card{padding:22px}
      .lp-replace-card ul{grid-template-columns:1fr}
      .lp-offer-card{padding:26px 22px}
      .lp-offer-price strong{font-size:58px}
      .lp-checkout-shell{border-radius:12px}
      .lp-checkout-shell iframe{height:1320px}
      .lp-final{padding:72px 0}
      .lp-footer{padding-bottom:92px}
      .lp-footer .p-wrap{display:grid}
      .lp-mobile-cta{display:block;position:fixed;left:0;right:0;bottom:0;z-index:80;padding:10px 12px calc(10px + env(safe-area-inset-bottom));background:rgba(8,8,8,.96);border-top:1px solid rgba(255,255,255,.12);backdrop-filter:blur(8px)}
